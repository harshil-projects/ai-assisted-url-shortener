+package dev.harshil.shortener.api;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import dev.harshil.shortener.config.AppProperties;
+import java.time.Duration;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.web.context.request.RequestContextHolder;
+import org.springframework.web.context.request.ServletRequestAttributes;
+
+class ShortUrlBuilderTest {
+
+  @AfterEach
+  void clearRequest() {
+    RequestContextHolder.resetRequestAttributes();
+  }
+
+  @Test
+  void shortUrl_withBaseUrlConfigured_usesItAndIgnoresTheRequest() {
+    bindRequest("http", "ignored.example", 8080);
+
+    String url = new ShortUrlBuilder(properties("https://sho.rt")).shortUrl("abc1234");
+
+    assertThat(url).isEqualTo("https://sho.rt/abc1234");
+  }
+
+  @Test
+  void shortUrl_baseUrlWithTrailingSlashOrWhitespace_doesNotDoubleTheSlash() {
+    String url = new ShortUrlBuilder(properties(" https://sho.rt/ ")).shortUrl("abc1234");
+
+    assertThat(url).isEqualTo("https://sho.rt/abc1234");
+  }
+
+  @Test
+  void shortUrl_withoutBaseUrl_usesCurrentRequestSchemeHostAndPort() {
+    bindRequest("https", "reviewer.example", 9090);
+
+    String url = new ShortUrlBuilder(properties("")).shortUrl("abc1234");
+
+    assertThat(url).isEqualTo("https://reviewer.example:9090/abc1234");
+  }
+
+  @Test
+  void shortUrl_withoutBaseUrlOnDefaultPort_omitsThePort() {
+    bindRequest("http", "localhost", 80);
+
+    String url = new ShortUrlBuilder(properties(null)).shortUrl("abc1234");
+
+    assertThat(url).isEqualTo("http://localhost/abc1234");
+  }
+
+  private static void bindRequest(String scheme, String host, int port) {
+    MockHttpServletRequest request = new MockHttpServletRequest();
+    request.setScheme(scheme);
+    request.setServerName(host);
+    request.setServerPort(port);
+    RequestContextHolder.setRequestAttributes(new ServletRequestAttributes(request));
+  }
+
+  private static AppProperties properties(String baseUrl) {
+    return new AppProperties(
+        "key",
+        baseUrl,
+        new AppProperties.RateLimit(new AppProperties.RateLimit.Create(20, Duration.ofMinutes(1))),
+        new AppProperties.Request(16_384),
+        new AppProperties.Security(true));
+  }
+}
diff --git a/url-shortener/src/test/java/dev/harshil/shortener/service/LinkAllocatorTest.java b/url-shortener/src/test/java/dev/harshil/shortener/service/LinkAllocatorTest.java
new file mode 100644
index 0000000..cf19cac
--- /dev/null
+++ b/url-shortener/src/test/java/dev/harshil/shortener/service/LinkAllocatorTest.java
@@ -0,0 +1,82 @@
+package dev.harshil.shortener.service;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import dev.harshil.shortener.domain.Link;
+import dev.harshil.shortener.repository.LinkRepository;
+import dev.harshil.shortener.support.TestProfile;
+import java.time.Instant;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.data.jpa.test.autoconfigure.DataJpaTest;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase;
+import org.springframework.boot.jdbc.test.autoconfigure.AutoConfigureTestDatabase.Replace;
+import org.springframework.context.annotation.Import;
+import org.springframework.dao.DataIntegrityViolationException;
+import org.springframework.transaction.annotation.Propagation;
+import org.springframework.transaction.annotation.Transactional;
+
+/**
+ * Runs against the real H2 schema with no surrounding test transaction, so every {@code insert}
+ * commits or rolls back exactly as it does in production and the unique constraint is the arbiter.
+ */
+@DataJpaTest
+@AutoConfigureTestDatabase(replace = Replace.NONE)
+@Import(LinkAllocator.class)
+@Transactional(propagation = Propagation.NOT_SUPPORTED)
+@TestProfile
+class LinkAllocatorTest {
+
+  private static final Instant NOW = Instant.parse("2026-10-12T10:00:00Z");
+
+  @Autowired private LinkAllocator allocator;
+  @Autowired private LinkRepository links;
+
+  @AfterEach
+  void cleanTables() {
+    links.deleteAllInBatch();
+  }
+
+  @Test
+  void insert_newCode_commitsARowThatIsVisibleAfterTheCall() {
+    Link inserted = allocator.insert("alloc01", "https://example.com/a", NOW);
+
+    assertThat(inserted.getId()).isNotNull();
+    assertThat(links.findByCode("alloc01"))
+        .hasValueSatisfying(
+            link -> {
+              assertThat(link.getOriginalUrl()).isEqualTo("https://example.com/a");
+              assertThat(link.getCreatedAt()).isEqualTo(NOW);
+            });
+  }
+
+  @Test
+  void insert_duplicateCode_throwsDataIntegrityViolationNamingTheConstraintAndKeepsTheFirstRow() {
+    allocator.insert("dupe001", "https://example.com/first", NOW);
+
+    assertThatThrownBy(() -> allocator.insert("dupe001", "https://example.com/second", NOW))
+        .isInstanceOf(DataIntegrityViolationException.class)
+        .message()
+        .containsIgnoringCase("uk_links_code");
+
+    assertThat(links.findByCode("dupe001"))
+        .hasValueSatisfying(
+            link -> assertThat(link.getOriginalUrl()).isEqualTo("https://example.com/first"));
+    assertThat(links.count()).isEqualTo(1);
+  }
+
+  @Test
+  void insert_afterAFailedAttempt_nextCodeStillCommitsBecauseEachAttemptIsItsOwnTransaction() {
+    allocator.insert("retry01", "https://example.com/one", NOW);
+    assertThatThrownBy(() -> allocator.insert("retry01", "https://example.com/two", NOW))
+        .isInstanceOf(DataIntegrityViolationException.class);
+
+    Link second = allocator.insert("retry02", "https://example.com/two", NOW);
+
+    assertThat(second.getId()).isNotNull();
+    assertThat(links.existsByCode("retry02")).isTrue();
+    assertThat(links.count()).isEqualTo(2);
+  }
+}
diff --git a/url-shortener/src/test/java/dev/harshil/shortener/service/LinkServiceTest.java b/url-shortener/src/test/java/dev/harshil/shortener/service/LinkServiceTest.java
