--- /dev/null
+++ b/url-shortener/src/main/java/dev/harshil/shortener/domain/AliasTakenException.java
@@ -0,0 +1,36 @@
+package dev.harshil.shortener.domain;
+
+/**
+ * Raised when a requested custom alias is already a stored code, whether the fast-path existence
+ * check saw it or two requests raced and the unique constraint decided (ADR 0003). Mapped to the
+ * 409 {@code alias-taken} problem (design 3.4).
+ */
+public final class AliasTakenException extends RuntimeException {
+
+  private final String alias;
+
+  /**
+   * Creates the exception when the existence check found the alias.
+   *
+   * @param alias the alias the client asked for; it has already passed the alias pattern
+   */
+  public AliasTakenException(String alias) {
+    this(alias, null);
+  }
+
+  /**
+   * Creates the exception when the database constraint rejected the insert, keeping the original
+   * failure as the cause for diagnostics.
+   *
+   * @param alias the alias the client asked for; it has already passed the alias pattern
+   * @param cause the constraint violation, or {@code null}
+   */
+  public AliasTakenException(String alias, Throwable cause) {
+    super("Alias already in use: " + LogSanitizer.sanitize(alias), cause);
+    this.alias = alias;
+  }
+
+  public String getAlias() {
+    return alias;
+  }
+}
diff --git a/url-shortener/src/main/java/dev/harshil/shortener/domain/CodeGenerationExhaustedException.java b/url-shortener/src/main/java/dev/harshil/shortener/domain/CodeGenerationExhaustedException.java
new file mode 100644
index 0000000..e0fc031
--- /dev/null
+++ b/url-shortener/src/main/java/dev/harshil/shortener/domain/CodeGenerationExhaustedException.java
@@ -0,0 +1,26 @@
+package dev.harshil.shortener.domain;
+
+/**
+ * Raised when every allocation attempt for a random code collided with an existing one. With a 62^7
+ * code space this is astronomically unlikely unless the table is nearly full or the random source
+ * is broken, so it is treated as a server fault: 500 {@code code-generation-exhausted} (design
+ * 3.4), and the client may simply retry.
+ */
+public final class CodeGenerationExhaustedException extends RuntimeException {
+
+  private final int attempts;
+
+  /**
+   * Creates the exception.
+   *
+   * @param attempts how many codes were tried before giving up
+   */
+  public CodeGenerationExhaustedException(int attempts) {
+    super("Could not allocate a unique code after " + attempts + " attempts");
+    this.attempts = attempts;
+  }
+
+  public int getAttempts() {
+    return attempts;
+  }
+}
