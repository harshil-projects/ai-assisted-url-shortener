+package dev.harshil.shortener.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import dev.harshil.shortener.api.ProblemDetails;
+import jakarta.servlet.ServletException;
+import java.util.concurrent.atomic.AtomicReference;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.AfterEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.slf4j.MDC;
+import org.springframework.mock.web.MockFilterChain;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+
+class RequestIdFilterTest {
+
+  private static final String UUID_PATTERN =
+      "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
+
+  private final RequestIdFilter filter = new RequestIdFilter();
+
+  @AfterEach
+  void clearMdc() {
+    MDC.clear();
+  }
+
+  static Stream<String> wellFormedIds() {
+    return Stream.of("1", "client-ID-0042", "a".repeat(64));
+  }
+
+  static Stream<String> malformedIds() {
+    return Stream.of(
+        "", "has space", "with_underscore", "with/slash", "crlf\r\nX-Injected: 1", "a".repeat(65));
+  }
+
+  @ParameterizedTest
+  @MethodSource("wellFormedIds")
+  void doFilter_wellFormedClientId_isEchoedOnTheResponse(String clientId) throws Exception {
+    MockHttpServletRequest request = request(clientId);
+    MockHttpServletResponse response = new MockHttpServletResponse();
+
+    filter.doFilter(request, response, new MockFilterChain());
+
+    assertThat(response.getHeader(RequestIdFilter.HEADER)).isEqualTo(clientId);
+  }
+
+  @ParameterizedTest
+  @MethodSource("malformedIds")
+  void doFilter_malformedClientId_isReplacedByGeneratedUuid(String clientId) throws Exception {
+    MockHttpServletRequest request = request(clientId);
+    MockHttpServletResponse response = new MockHttpServletResponse();
+
+    filter.doFilter(request, response, new MockFilterChain());
+
+    assertThat(response.getHeader(RequestIdFilter.HEADER))
+        .isNotEqualTo(clientId)
+        .matches(UUID_PATTERN);
+  }
+
+  @Test
+  void doFilter_noClientId_generatesUuid() throws Exception {
+    MockHttpServletResponse response = new MockHttpServletResponse();
+
+    filter.doFilter(new MockHttpServletRequest("GET", "/abcdefg"), response, new MockFilterChain());
+
+    assertThat(response.getHeader(RequestIdFilter.HEADER)).matches(UUID_PATTERN);
+  }
+
+  @Test
+  void doFilter_duringTheChain_exposesTheIdInMdcUnderTheProblemDetailsKey() throws Exception {
+    AtomicReference<String> seenByChain = new AtomicReference<>();
+
+    filter.doFilter(
+        request("trace-7"),
+        new MockHttpServletResponse(),
+        (req, res) -> seenByChain.set(MDC.get(ProblemDetails.REQUEST_ID)));
+
+    assertThat(seenByChain).hasValue("trace-7");
+  }
+
+  @Test
+  void doFilter_afterTheChain_removesTheIdFromMdc() throws Exception {
+    filter.doFilter(request("trace-8"), new MockHttpServletResponse(), new MockFilterChain());
+
+    assertThat(MDC.get(ProblemDetails.REQUEST_ID)).isNull();
+  }
+
+  @Test
+  void doFilter_whenTheChainThrows_stillRemovesTheIdFromMdc() {
+    MockHttpServletRequest request = request("trace-9");
+    MockHttpServletResponse response = new MockHttpServletResponse();
+
+    assertThatThrownBy(
+            () ->
+                filter.doFilter(
+                    request,
+                    response,
+                    (req, res) -> {
+                      throw new ServletException("downstream failure");
+                    }))
+        .isInstanceOf(ServletException.class);
+
+    assertThat(MDC.get(ProblemDetails.REQUEST_ID)).isNull();
+    assertThat(response.getHeader(RequestIdFilter.HEADER)).isEqualTo("trace-9");
+  }
+
+  private static MockHttpServletRequest request(String clientId) {
+    MockHttpServletRequest request = new MockHttpServletRequest("GET", "/abcdefg");
+    request.addHeader(RequestIdFilter.HEADER, clientId);
+    return request;
+  }
+}
diff --git a/url-shortener/src/test/java/dev/harshil/shortener/config/RequestSizeFilterTest.java b/url-shortener/src/test/java/dev/harshil/shortener/config/RequestSizeFilterTest.java
new file mode 100644
index 0000000..929d421
--- /dev/null
+++ b/url-shortener/src/test/java/dev/harshil/shortener/config/RequestSizeFilterTest.java
@@ -0,0 +1,213 @@
+package dev.harshil.shortener.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+import static org.assertj.core.api.Assertions.assertThatThrownBy;
+
+import dev.harshil.shortener.api.ProblemWriter;
+import jakarta.servlet.ServletInputStream;
+import jakarta.servlet.http.HttpServletRequest;
+import jakarta.servlet.http.HttpServletRequestWrapper;
+import java.io.BufferedReader;
+import java.nio.charset.StandardCharsets;
+import java.time.Duration;
+import java.util.concurrent.atomic.AtomicReference;
+import org.junit.jupiter.api.Test;
+import org.springframework.http.MediaType;
+import org.springframework.mock.web.MockFilterChain;
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import tools.jackson.databind.json.JsonMapper;
+
+class RequestSizeFilterTest {
+
+  private static final int MAX_BYTES = 64;
+  private static final byte[] SMALL_JSON =
+      "{\"url\":\"https://example.com/a\"}".getBytes(StandardCharsets.UTF_8);
+
+  private final RequestSizeFilter filter =
+      new RequestSizeFilter(properties(MAX_BYTES), new ProblemWriter(JsonMapper.builder().build()));
+
+  @Test
+  void doFilter_declaredLengthOverLimit_returns413WithoutReadingTheBody() throws Exception {
+    HttpServletRequest request = unreadable(apiPost(new byte[MAX_BYTES + 1]));
+    MockHttpServletResponse response = new MockHttpServletResponse();
+    MockFilterChain chain = new MockFilterChain();
+
+    filter.doFilter(request, response, chain);
+
+    assertThat(chain.getRequest()).isNull();
+    assertThat(response.getStatus()).isEqualTo(413);
+    assertThat(response.getContentType()).startsWith(MediaType.APPLICATION_PROBLEM_JSON_VALUE);
+    assertThat(response.getContentAsString())
+        .contains("\"type\":\"/problems/payload-too-large\"")
+        .contains("\"title\":\"Request body too large\"")
+        .contains("\"status\":413")
+        .contains("64 bytes");
+  }
+
+  @Test
+  void doFilter_declaredLengthAtLimit_passesTheOriginalRequestThrough() throws Exception {
+    MockHttpServletRequest request = apiPost(new byte[MAX_BYTES]);
+    MockFilterChain chain = new MockFilterChain();
+
+    filter.doFilter(request, new MockHttpServletResponse(), chain);
+
+    assertThat(chain.getRequest()).isSameAs(request);
+  }
+
+  @Test
+  void doFilter_unknownLengthWithinLimit_replaysTheBodyThroughGetInputStream() throws Exception {
+    AtomicReference<byte[]> seenByChain = new AtomicReference<>();
+
+    filter.doFilter(
+        unknownLength(apiPost(SMALL_JSON)),
+        new MockHttpServletResponse(),
+        (req, res) -> seenByChain.set(req.getInputStream().readAllBytes()));
+
+    assertThat(seenByChain.get()).isEqualTo(SMALL_JSON);
+  }
+
+  @Test
+  void doFilter_unknownLengthWithinLimit_replaysTheBodyThroughGetReaderInRequestCharset()
+      throws Exception {
+    MockHttpServletRequest request =
+        apiPost("{\"url\":\"https://exämple.com\"}".getBytes(StandardCharsets.UTF_8));
+    request.setCharacterEncoding(StandardCharsets.UTF_8.name());
+    AtomicReference<String> seenByChain = new AtomicReference<>();
+
+    filter.doFilter(
+        unknownLength(request),
+        new MockHttpServletResponse(),
+        (req, res) -> seenByChain.set(req.getReader().readLine()));
+
+    assertThat(seenByChain).hasValue("{\"url\":\"https://exämple.com\"}");
+  }
+
+  @Test
+  void doFilter_unknownLengthAtLimit_isAccepted() throws Exception {
+    MockFilterChain chain = new MockFilterChain();
+
+    filter.doFilter(
+        unknownLength(apiPost(new byte[MAX_BYTES])), new MockHttpServletResponse(), chain);
+
+    assertThat(chain.getRequest()).isNotNull();
+    assertThat(chain.getRequest().getContentLengthLong()).isEqualTo(MAX_BYTES);
+  }
+
+  @Test
+  void doFilter_unknownLengthOverLimit_returns413() throws Exception {
+    MockHttpServletResponse response = new MockHttpServletResponse();
+    MockFilterChain chain = new MockFilterChain();
+
+    filter.doFilter(unknownLength(apiPost(new byte[MAX_BYTES + 1])), response, chain);
+
+    assertThat(chain.getRequest()).isNull();
+    assertThat(response.getStatus()).isEqualTo(413);
+    assertThat(response.getContentAsString()).contains("\"type\":\"/problems/payload-too-large\"");
+  }
+
+  @Test
+  void doFilter_outsideTheApiPrefix_isNotApplied() throws Exception {
+    MockHttpServletRequest request = new MockHttpServletRequest("POST", "/abcdefg");
+    request.setContent(new byte[MAX_BYTES + 1]);
+    MockFilterChain chain = new MockFilterChain();
+
+    filter.doFilter(request, new MockHttpServletResponse(), chain);
+
+    assertThat(chain.getRequest()).isSameAs(request);
+  }
+
+  @Test
+  void bufferedBodyRequest_getReaderAfterGetInputStream_isRejected() throws Exception {
+    RequestSizeFilter.BufferedBodyRequest request =
+        new RequestSizeFilter.BufferedBodyRequest(apiPost(SMALL_JSON), SMALL_JSON);
+    ServletInputStream first = request.getInputStream();
+    first.readAllBytes();
+
+    // A second stream replays the buffer from the start; the reader stays off limits.
+    assertThat(request.getInputStream().readAllBytes()).isEqualTo(SMALL_JSON);
+    assertThatThrownBy(request::getReader).isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void bufferedBodyRequest_getInputStreamAfterGetReader_isRejected() throws Exception {
+    RequestSizeFilter.BufferedBodyRequest request =
+        new RequestSizeFilter.BufferedBodyRequest(apiPost(SMALL_JSON), SMALL_JSON);
+    BufferedReader first = request.getReader();
+
+    assertThat(first.readLine()).isEqualTo(new String(SMALL_JSON, StandardCharsets.UTF_8));
+    assertThatThrownBy(request::getInputStream).isInstanceOf(IllegalStateException.class);
+  }
+
+  @Test
+  void bufferedBodyRequest_withoutCharacterEncoding_readsUtf8() throws Exception {
+    byte[] body = "ü".getBytes(StandardCharsets.UTF_8);
+    RequestSizeFilter.BufferedBodyRequest request =
+        new RequestSizeFilter.BufferedBodyRequest(apiPost(body), body);
+
+    assertThat(request.getReader().readLine()).isEqualTo("ü");
+    assertThat(request.getContentLength()).isEqualTo(body.length);
+  }
+
+  @Test
+  void byteArrayServletInputStream_reportsReadinessAndCompletionAndRejectsAsyncReads()
+      throws Exception {
+    RequestSizeFilter.ByteArrayServletInputStream stream =
+        new RequestSizeFilter.ByteArrayServletInputStream(new byte[] {1, 2});
+
+    assertThat(stream.isReady()).isTrue();
+    assertThat(stream.isFinished()).isFalse();
+    assertThat(stream.available()).isEqualTo(2);
+    assertThat(stream.read()).isEqualTo(1);
+    assertThat(stream.read(new byte[4], 0, 4)).isEqualTo(1);
+    assertThat(stream.isFinished()).isTrue();
+    assertThatThrownBy(() -> stream.setReadListener(null))
+        .isInstanceOf(IllegalStateException.class);
+  }
+
+  private static MockHttpServletRequest apiPost(byte[] body) {
+    MockHttpServletRequest request = new MockHttpServletRequest("POST", "/api/v1/links");
+    request.setContentType(MediaType.APPLICATION_JSON_VALUE);
+    request.setContent(body);
+    return request;
+  }
+
+  /** Simulates a chunked request: the body is there but no length was declared. */
+  private static HttpServletRequest unknownLength(HttpServletRequest request) {
+    return new HttpServletRequestWrapper(request) {
+      @Override
+      public int getContentLength() {
+        return -1;
+      }
+
+      @Override
+      public long getContentLengthLong() {
+        return -1;
+      }
+    };
+  }
+
+  /** Fails the test if anything touches the body. */
+  private static HttpServletRequest unreadable(HttpServletRequest request) {
+    return new HttpServletRequestWrapper(request) {
+      @Override
+      public ServletInputStream getInputStream() {
+        throw new AssertionError("the body must not be read when Content-Length is over the limit");
+      }
+
+      @Override
+      public BufferedReader getReader() {
+        throw new AssertionError("the body must not be read when Content-Length is over the limit");
+      }
+    };
+  }
+
+  private static AppProperties properties(long maxBytes) {
+    return new AppProperties(
+        "key",
+        null,
+        new AppProperties.RateLimit(new AppProperties.RateLimit.Create(20, Duration.ofMinutes(1))),
+        new AppProperties.Request(maxBytes),
+        new AppProperties.Security(true));
+  }
+}
diff --git a/url-shortener/src/test/java/dev/harshil/shortener/config/SecurityHeadersIT.java b/url-shortener/src/test/java/dev/harshil/shortener/config/SecurityHeadersIT.java
new file mode 100644
index 0000000..61ecd85
--- /dev/null
+++ b/url-shortener/src/test/java/dev/harshil/shortener/config/SecurityHeadersIT.java
@@ -0,0 +1,125 @@
+package dev.harshil.shortener.config;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import dev.harshil.shortener.support.TestApiKey;
+import dev.harshil.shortener.support.TestProfile;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.MethodSource;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.beans.factory.annotation.Autowired;
+import org.springframework.boot.resttestclient.autoconfigure.AutoConfigureRestTestClient;
+import org.springframework.boot.test.context.SpringBootTest;
+import org.springframework.boot.test.context.SpringBootTest.WebEnvironment;
+import org.springframework.http.HttpHeaders;
+import org.springframework.http.MediaType;
+import org.springframework.test.web.servlet.client.RestTestClient;
+
+/**
+ * The hardening headers every response must carry (design 3.3, NFR-05), the correlation id contract
+ * of {@link RequestIdFilter}, and the two exceptions: the Swagger-only Content-Security-Policy and
+ * the public OpenAPI document.
+ */
+@SpringBootTest(webEnvironment = WebEnvironment.RANDOM_PORT)
+@AutoConfigureRestTestClient
+@TestProfile
+class SecurityHeadersIT {
+
+  private static final String SWAGGER_CSP =
+      "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; "
+          + "frame-ancestors 'none'; object-src 'none'";
+  private static final String UUID_PATTERN =
+      "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}";
+
+  @Autowired private RestTestClient client;
+
+  static Stream<String> malformedRequestIds() {
+    return Stream.of("has space", "a".repeat(65));
+  }
+
+  @ParameterizedTest
+  @ValueSource(strings = {"/abcdefg", "/api/v1/links/abcdefg"})
+  void anyResponse_carriesHardeningHeadersAndRequestId(String path) {
+    client
+        .get()
+        .uri(path)
+        .header(TestApiKey.HEADER, TestApiKey.VALUE)
+        .exchange()
+        .expectHeader()
+        .valueEquals("X-Content-Type-Options", "nosniff")
+        .expectHeader()
+        .valueEquals("X-Frame-Options", "DENY")
+        .expectHeader()
+        .valueEquals("Referrer-Policy", "no-referrer")
+        .expectHeader()
+        .value(HttpHeaders.CACHE_CONTROL, value -> assertThat(value).contains("no-store"))
+        .expectHeader()
+        .valueMatches(RequestIdFilter.HEADER, UUID_PATTERN)
+        .expectHeader()
+        .doesNotExist("Content-Security-Policy");
+  }
+
+  @Test
+  void requestId_wellFormedClientValue_isEchoed() {
+    client
+        .get()
+        .uri("/actuator/health")
+        .header(RequestIdFilter.HEADER, "trace-0001")
+        .exchange()
+        .expectStatus()
+        .isOk()
+        .expectHeader()
+        .valueEquals(RequestIdFilter.HEADER, "trace-0001");
+  }
+
+  @ParameterizedTest
+  @MethodSource("malformedRequestIds")
+  void requestId_malformedClientValue_isReplaced(String clientValue) {
+    client
+        .get()
+        .uri("/actuator/health")
+        .header(RequestIdFilter.HEADER, clientValue)
+        .exchange()
+        .expectStatus()
+        .isOk()
+        .expectHeader()
+        .value(
+            RequestIdFilter.HEADER,
+            value -> assertThat(value).isNotEqualTo(clientValue).matches(UUID_PATTERN));
+  }
+
+  @Test
+  void swaggerUi_carriesTheSwaggerOnlyContentSecurityPolicy() {
+    client
+        .get()
+        .uri("/swagger-ui/index.html")
+        .exchange()
+        .expectStatus()
+        .isOk()
+        .expectHeader()
+        .valueEquals("Content-Security-Policy", SWAGGER_CSP)
+        .expectHeader()
+        .valueEquals("Referrer-Policy", "no-referrer")
+        .expectHeader()
+        .exists(RequestIdFilter.HEADER);
+  }
+
+  @Test
+  void apiDocs_withoutKey_isPublicJson() {
+    client
+        .get()
+        .uri("/v3/api-docs")
+        .exchange()
+        .expectStatus()
+        .isOk()
+        .expectHeader()
+        .contentTypeCompatibleWith(MediaType.APPLICATION_JSON)
+        .expectBody()
+        .jsonPath("$.openapi")
+        .exists()
+        .jsonPath("$.info.title")
+        .isEqualTo("URL Shortener API");
+  }
+}
