+# Developer and reviewer profile (default). Embedded H2 in file mode under ./data, relative to the
+# working directory, in PostgreSQL compatibility mode so the SQL stays portable (ADR 0002).
+spring.datasource.url=jdbc:h2:./data/urlshortener;MODE=PostgreSQL;DATABASE_TO_LOWER=TRUE;DEFAULT_NULL_ORDERING=HIGH;DB_CLOSE_ON_EXIT=FALSE
+spring.datasource.username=sa
+spring.datasource.password=
+spring.h2.console.enabled=true
+spring.h2.console.path=/h2-console
+
+# Development API key. Documented on the README first screen; the prod profile refuses to start
+# without APP_API_KEY (ADR 0007).
+app.api-key=${APP_API_KEY:dev-only-key-do-not-use}
+# Generous so clicking through Swagger UI does not trip the limiter.
+app.ratelimit.create.capacity=100
+app.security.actuator-requires-api-key=false
+
+management.endpoint.health.show-details=always
+logging.level.dev.harshil.shortener=DEBUG
+# Correlation id from RequestIdFilter in every line.
+logging.pattern.level=%5p [req=%X{requestId:-}]
