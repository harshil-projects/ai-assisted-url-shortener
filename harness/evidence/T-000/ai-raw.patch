@@ -0,0 +1,40 @@
+package dev.harshil.shortener.harness;
+
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * One gate run appended to the ledger by the gate script.
+ *
+ * @param task the task id, or null when missing
+ * @param commit the commit the gates ran against, or null when missing
+ * @param overall {@code pass} or {@code fail}, or null when missing
+ * @param results the per-gate results keyed by gate name; a missing value is the empty string
+ * @param log the repository-relative gate log path, or null when missing
+ */
+public record GateRecord(
+    String task, String commit, String overall, Map<String, String> results, String log) {
+
+  /** Builds a gate record from one item of the ledger's {@code gates} list. */
+  static GateRecord fromYaml(Map<String, Object> yaml) {
+    Map<String, String> results = new LinkedHashMap<>();
+    YamlValues.asMap(yaml.get("results"))
+        .forEach((key, value) -> results.put(key, value == null ? "" : value.toString()));
+    return new GateRecord(
+        YamlValues.scalar(yaml, "task"),
+        YamlValues.scalar(yaml, "commit"),
+        YamlValues.scalar(yaml, "overall"),
+        Map.copyOf(results),
+        YamlValues.scalar(yaml, "log"));
+  }
+
+  /** True when the overall result is {@code pass}. */
+  public boolean isPass() {
+    return Vocabulary.PASS.equals(overall);
+  }
+
+  /** The subject to name in violations: the task id, or a placeholder when it is missing. */
+  public String subject() {
+    return task == null || task.isBlank() ? "<gate record without task>" : task;
+  }
+}
diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/GitLog.java b/harness-check/src/main/java/dev/harshil/shortener/harness/GitLog.java
new file mode 100644
index 0000000..903f832
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/GitLog.java
@@ -0,0 +1,194 @@
+package dev.harshil.shortener.harness;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.Optional;
+import java.util.concurrent.TimeUnit;
+
+/**
+ * The non-merge commits after the {@code baseline} tag, read through the git command line. When
+ * {@code .git} is absent, git is not on the PATH, or the tag does not exist, the log is marked
+ * skipped with a reason and rules that need history are skipped rather than failed.
+ */
+public final class GitLog {
+
+  private static final String BASELINE_TAG = "baseline";
+  private static final String FIELD_SEPARATOR = "\u001f";
+  private static final String RECORD_SEPARATOR = "\u001e";
+  private static final String LOG_FORMAT = "%H%x1f%an%x1f%s%x1f%b%x1e";
+  private static final String TRAILER_PREFIX = "Task:";
+  private static final long TIMEOUT_SECONDS = 60;
+
+  /**
+   * One commit from the log.
+   *
+   * @param sha the full commit hash
+   * @param author the author name
+   * @param subject the first line of the message
+   * @param body the remaining message lines, possibly empty
+   */
+  public record Commit(String sha, String author, String subject, String body) {
+
+    /** True when the author is an automation account such as Dependabot. */
+    public boolean isBot() {
+      String name = author.toLowerCase(Locale.ROOT);
+      return name.contains("[bot]") || name.contains("dependabot");
+    }
+
+    /** The task ids named on {@code Task:} trailer lines, in order; empty when there is none. */
+    public List<String> taskReferences() {
+      List<String> references = new ArrayList<>();
+      for (String line : body.lines().toList()) {
+        String trimmed = line.trim();
+        if (!trimmed.startsWith(TRAILER_PREFIX)) {
+          continue;
+        }
+        for (String token : trimmed.substring(TRAILER_PREFIX.length()).trim().split("[,\\s]+")) {
+          if (!token.isEmpty()) {
+            references.add(token);
+          }
+        }
+      }
+      return references;
+    }
+
+    /** The short hash and subject, for violation messages. */
+    public String label() {
+      return sha.substring(0, Math.min(12, sha.length())) + " " + subject;
+    }
+  }
+
+  private record Result(int exitCode, String output) {}
+
+  private final Path root;
+  private final boolean skipped;
+  private final String skipReason;
+  private final List<Commit> commits;
+
+  private GitLog(Path root, boolean skipped, String skipReason, List<Commit> commits) {
+    this.root = root;
+    this.skipped = skipped;
+    this.skipReason = skipReason;
+    this.commits = commits;
+  }
+
+  /** Reads the log for the repository at the root, or returns a skipped log with the reason. */
+  public static GitLog load(Path root) {
+    if (!Files.exists(root.resolve(".git"))) {
+      return unavailable(root, "no .git directory under " + root);
+    }
+    Optional<Result> tag =
+        run(root, "git", "rev-parse", "--verify", "--quiet", "refs/tags/" + BASELINE_TAG);
+    if (tag.isEmpty()) {
+      return unavailable(root, "git is not on the PATH or could not be started");
+    }
+    if (tag.get().exitCode() != 0) {
+      return unavailable(root, "tag '" + BASELINE_TAG + "' does not exist");
+    }
+    Optional<Result> log =
+        run(root, "git", "log", "--format=" + LOG_FORMAT, "--no-merges", BASELINE_TAG + "..HEAD");
+    if (log.isEmpty() || log.get().exitCode() != 0) {
+      String detail = log.map(Result::output).orElse("").trim();
+      return unavailable(root, "git log failed" + (detail.isEmpty() ? "" : ": " + detail));
+    }
+    return new GitLog(root, false, "", parse(log.get().output()));
+  }
+
+  /** A log that could not be read, carrying the reason for skipping history rules. */
+  public static GitLog unavailable(Path root, String reason) {
+    return new GitLog(root, true, reason, List.of());
+  }
+
+  /** A log built from known commits, for tests that must not depend on a real repository. */
+  static GitLog of(Path root, List<Commit> commits) {
+    return new GitLog(root, false, "", List.copyOf(commits));
+  }
+
+  /** True when history could not be read; see {@link #skipReason()}. */
+  public boolean skipped() {
+    return skipped;
+  }
+
+  /** Why history was skipped, or the empty string when it was read. */
+  public String skipReason() {
+    return skipReason;
+  }
+
+  /** The non-merge commits after the baseline tag, newest first; empty when skipped. */
+  public List<Commit> commits() {
+    return commits;
+  }
+
+  /** The commits whose {@code Task:} trailer names the task. */
+  public List<Commit> commitsFor(String taskId) {
+    return commits.stream().filter(commit -> commit.taskReferences().contains(taskId)).toList();
+  }
+
+  /** The repository-relative paths changed by the commit; empty when skipped or on failure. */
+  public List<String> changedFiles(String sha) {
+    if (skipped) {
+      return List.of();
+    }
+    Optional<Result> result =
+        run(
+            root,
+            "git",
+            "-c",
+            "core.quotepath=false",
+            "diff-tree",
+            "--no-commit-id",
+            "--name-only",
+            "-r",
+            sha);
+    if (result.isEmpty() || result.get().exitCode() != 0) {
+      return List.of();
+    }
+    return result.get().output().lines().map(String::trim).filter(line -> !line.isEmpty()).toList();
+  }
+
+  static List<Commit> parse(String output) {
+    List<Commit> commits = new ArrayList<>();
+    for (String entry : output.split(RECORD_SEPARATOR)) {
+      String chunk = entry.strip();
+      if (chunk.isEmpty()) {
+        continue;
+      }
+      String[] fields = chunk.split(FIELD_SEPARATOR, 4);
+      if (fields.length < 3) {
+        continue;
+      }
+      String body = fields.length == 4 ? fields[3] : "";
+      commits.add(new Commit(fields[0].trim(), fields[1], fields[2], body));
+    }
+    return List.copyOf(commits);
+  }
+
+  private static Optional<Result> run(Path directory, String... command) {
+    ProcessBuilder builder =
+        new ProcessBuilder(command).directory(directory.toFile()).redirectErrorStream(true);
+    try {
+      Process process = builder.start();
+      byte[] output;
+      try (InputStream in = process.getInputStream()) {
+        output = in.readAllBytes();
+      }
+      if (!process.waitFor(TIMEOUT_SECONDS, TimeUnit.SECONDS)) {
+        process.destroyForcibly();
+        return Optional.empty();
+      }
+      String text = new String(output, StandardCharsets.UTF_8);
+      return Optional.of(new Result(process.exitValue(), text));
+    } catch (IOException e) {
+      return Optional.empty();
+    } catch (InterruptedException e) {
+      Thread.currentThread().interrupt();
+      return Optional.empty();
+    }
+  }
+}
diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/HarnessRepo.java b/harness-check/src/main/java/dev/harshil/shortener/harness/HarnessRepo.java
new file mode 100644
index 0000000..fe97abb
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/HarnessRepo.java
@@ -0,0 +1,190 @@
+package dev.harshil.shortener.harness;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.Comparator;
+import java.util.List;
+import java.util.Map;
+import java.util.Optional;
+import java.util.stream.Stream;
+import org.yaml.snakeyaml.LoaderOptions;
+import org.yaml.snakeyaml.Yaml;
+import org.yaml.snakeyaml.constructor.SafeConstructor;
+
+/**
+ * Locates and loads the harness data under a repository root: task specs, the ledger, prompts,
+ * evidence, and reviews. Missing files load as empty data; unreadable files become violations
+ * attributed to the rule that owns the file.
+ */
+public final class HarnessRepo {
+
+  private static final String TASK_EXTENSION = ".yaml";
+  private static final String ROOT_PROPERTY = "harness.root";
+  private static final String MODULE_DIRECTORY = "harness-check";
+
+  private final Path root;
+  private final List<TaskSpec> tasks;
+  private final Ledger ledger;
+  private final List<Violation> loadProblems;
+
+  private HarnessRepo(Path root, List<TaskSpec> tasks, Ledger ledger, List<Violation> problems) {
+    this.root = root;
+    this.tasks = tasks;
+    this.ledger = ledger;
+    this.loadProblems = problems;
+  }
+
+  /** Opens the harness rooted at the given repository directory. */
+  public static HarnessRepo open(Path root) {
+    Path normalized = root.toAbsolutePath().normalize();
+    List<Violation> problems = new ArrayList<>();
+    List<TaskSpec> tasks = loadTasks(normalized.resolve("harness").resolve("tasks"), problems);
+    Ledger ledger = loadLedger(normalized.resolve("harness").resolve("ledger.yaml"), problems);
+    return new HarnessRepo(normalized, tasks, ledger, List.copyOf(problems));
+  }
+
+  /**
+   * Resolves the repository root: the {@code harness.root} system property when set, otherwise the
+   * parent of the working directory when that directory is the module itself, otherwise the working
+   * directory.
+   */
+  public static Path defaultRoot() {
+    String configured = System.getProperty(ROOT_PROPERTY);
+    if (configured != null && !configured.isBlank()) {
+      return Path.of(configured).toAbsolutePath().normalize();
+    }
+    Path cwd = Path.of("").toAbsolutePath().normalize();
+    Path name = cwd.getFileName();
+    if (name != null && MODULE_DIRECTORY.equals(name.toString()) && cwd.getParent() != null) {
+      return cwd.getParent();
+    }
+    return cwd;
+  }
+
+  /** The repository root. */
+  public Path root() {
+    return root;
+  }
+
+  /** The {@code harness/prompts} directory, which may not exist. */
+  public Path promptsDir() {
+    return root.resolve("harness").resolve("prompts");
+  }
+
+  /** The {@code harness/evidence} directory, which may not exist. */
+  public Path evidenceDir() {
+    return root.resolve("harness").resolve("evidence");
+  }
+
+  /** The {@code harness/reviews} directory, which may not exist. */
+  public Path reviewsDir() {
+    return root.resolve("harness").resolve("reviews");
+  }
+
+  /** All task specs, sorted by task id. */
+  public List<TaskSpec> tasks() {
+    return tasks;
+  }
+
+  /** The task with the given id, when one exists. */
+  public Optional<TaskSpec> task(String id) {
+    return tasks.stream().filter(task -> task.key().equals(id)).findFirst();
+  }
+
+  /** The parsed ledger, empty when the file does not exist. */
+  public Ledger ledger() {
+    return ledger;
+  }
+
+  /** Problems met while loading, attributed to the given rule. */
+  public List<Violation> loadProblems(String rule) {
+    return loadProblems.stream().filter(problem -> problem.rule().equals(rule)).toList();
+  }
+
+  /** Resolves a repository-relative path written with either slash style. */
+  public Path resolve(String relative) {
+    String cleaned = relative.trim().replace('\\', '/');
+    while (cleaned.startsWith("./")) {
+      cleaned = cleaned.substring(2);
+    }
+    return root.resolve(cleaned).normalize();
+  }
+
+  /** The repository-relative, forward-slash form of a path under the root. */
+  public String relativize(Path path) {
+    Path absolute = path.toAbsolutePath().normalize();
+    if (!absolute.startsWith(root)) {
+      return absolute.toString().replace('\\', '/');
+    }
+    return root.relativize(absolute).toString().replace('\\', '/');
+  }
+
+  /** True when the repository-relative path names an existing regular file. */
+  public boolean fileExists(String relative) {
+    return relative != null && !relative.isBlank() && Files.isRegularFile(resolve(relative));
+  }
+
+  /** Reads a text file as UTF-8 with malformed bytes replaced; empty when it cannot be read. */
+  public Optional<String> readText(Path file) {
+    if (!Files.isRegularFile(file)) {
+      return Optional.empty();
+    }
+    try {
+      return Optional.of(new String(Files.readAllBytes(file), StandardCharsets.UTF_8));
+    } catch (IOException e) {
+      return Optional.empty();
+    }
+  }
+
+  private static List<TaskSpec> loadTasks(Path dir, List<Violation> problems) {
+    if (!Files.isDirectory(dir)) {
+      return List.of();
+    }
+    List<TaskSpec> specs = new ArrayList<>();
+    try (Stream<Path> files = Files.list(dir)) {
+      List<Path> yamlFiles =
+          files
+              .filter(file -> file.getFileName().toString().endsWith(TASK_EXTENSION))
+              .sorted()
+              .toList();
+      for (Path file : yamlFiles) {
+        loadYaml(file, "HC-01", problems).ifPresent(map -> specs.add(TaskSpec.fromYaml(file, map)));
+      }
+    } catch (IOException e) {
+      problems.add(new Violation("HC-01", dir.toString(), "cannot list tasks: " + e.getMessage()));
+    }
+    specs.sort(Comparator.comparing(TaskSpec::key));
+    return List.copyOf(specs);
+  }
+
+  private static Ledger loadLedger(Path file, List<Violation> problems) {
+    if (!Files.isRegularFile(file)) {
+      return Ledger.empty();
+    }
+    return loadYaml(file, "HC-06", problems).map(Ledger::fromYaml).orElse(Ledger.empty());
+  }
+
+  private static Optional<Map<String, Object>> loadYaml(
+      Path file, String rule, List<Violation> problems) {
+    String subject = file.getFileName().toString();
+    try {
+      String text = Files.readString(file, StandardCharsets.UTF_8);
+      if (!text.isEmpty() && text.charAt(0) == 0xFEFF) {
+        text = text.substring(1);
+      }
+      Object loaded = new Yaml(new SafeConstructor(new LoaderOptions())).load(text);
+      if (loaded instanceof Map<?, ?>) {
+        return Optional.of(YamlValues.asMap(loaded));
+      }
+      problems.add(new Violation(rule, subject, "file is empty or not a YAML mapping"));
+    } catch (IOException e) {
+      problems.add(new Violation(rule, subject, "cannot read file: " + e.getMessage()));
+    } catch (RuntimeException e) {
+      problems.add(new Violation(rule, subject, "cannot parse YAML: " + e.getMessage()));
+    }
+    return Optional.empty();
+  }
+}
