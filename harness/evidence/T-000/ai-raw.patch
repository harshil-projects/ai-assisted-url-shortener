@@ -0,0 +1,206 @@
+<?xml version="1.0" encoding="UTF-8"?>
+<project xmlns="http://maven.apache.org/POM/4.0.0"
+         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
+         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
+  <modelVersion>4.0.0</modelVersion>
+
+  <parent>
+    <groupId>org.springframework.boot</groupId>
+    <artifactId>spring-boot-starter-parent</artifactId>
+    <version>4.1.1</version>
+    <relativePath/>
+  </parent>
+
+  <groupId>dev.harshil.shortener</groupId>
+  <artifactId>ai-assisted-url-shortener</artifactId>
+  <version>0.1.0-SNAPSHOT</version>
+  <packaging>pom</packaging>
+
+  <name>AI-Assisted URL Shortener (reactor)</name>
+  <description>
+    URL shortener service delivered through engineer-led, AI-accelerated execution, plus the
+    process-as-code checks that make the execution auditable. See README.md and docs/.
+  </description>
+
+  <modules>
+    <module>url-shortener</module>
+    <module>harness-check</module>
+  </modules>
+
+  <properties>
+    <java.version>21</java.version>
+    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
+    <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
+
+    <!-- Quality gate tool versions. Each was verified on Maven Central on 2026-10-12 (ADR 0001). -->
+    <spotless.version>3.10.4</spotless.version>
+    <!-- 1.37.0 adds a commonmark dependency that the Spotless 3.10.4 formatter step does not load
+         (NoClassDefFoundError org/commonmark/parser/Parser on every file); 1.36.1 is the version
+         Spotless 3.10.4 ships and tests with. Recorded in the T-000 ledger entry. -->
+    <google-java-format.version>1.36.1</google-java-format.version>
+    <checkstyle-plugin.version>3.6.0</checkstyle-plugin.version>
+    <checkstyle.version>14.3.0</checkstyle.version>
+    <spotbugs-plugin.version>4.10.4.1</spotbugs-plugin.version>
+    <findsecbugs.version>1.14.0</findsecbugs.version>
+    <jacoco.version>0.8.15</jacoco.version>
+    <enforcer.version>3.6.3</enforcer.version>
+
+    <!-- Surefire runs every test (unit, slice, integration) so one JaCoCo file covers all. -->
+    <surefire.excludedGroups>perf</surefire.excludedGroups>
+    <!-- Overwritten by jacoco:prepare-agent; declared empty so @{argLine} always resolves. -->
+    <argLine></argLine>
+  </properties>
+
+  <build>
+    <pluginManagement>
+      <plugins>
+        <plugin>
+          <groupId>com.diffplug.spotless</groupId>
+          <artifactId>spotless-maven-plugin</artifactId>
+          <version>${spotless.version}</version>
+        </plugin>
+        <plugin>
+          <groupId>org.apache.maven.plugins</groupId>
+          <artifactId>maven-checkstyle-plugin</artifactId>
+          <version>${checkstyle-plugin.version}</version>
+        </plugin>
+        <plugin>
+          <groupId>com.github.spotbugs</groupId>
+          <artifactId>spotbugs-maven-plugin</artifactId>
+          <version>${spotbugs-plugin.version}</version>
+        </plugin>
+        <plugin>
+          <groupId>org.jacoco</groupId>
+          <artifactId>jacoco-maven-plugin</artifactId>
+          <version>${jacoco.version}</version>
+        </plugin>
+        <plugin>
+          <groupId>org.apache.maven.plugins</groupId>
+          <artifactId>maven-enforcer-plugin</artifactId>
+          <version>${enforcer.version}</version>
+        </plugin>
+      </plugins>
+    </pluginManagement>
+
+    <plugins>
+      <!-- Gate: environment. Fails early on an unsupported JDK or Maven. -->
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-enforcer-plugin</artifactId>
+        <executions>
+          <execution>
+            <id>enforce-environment</id>
+            <goals>
+              <goal>enforce</goal>
+            </goals>
+            <configuration>
+              <rules>
+                <requireJavaVersion>
+                  <version>[21,27)</version>
+                  <message>JDK 21 or newer (below 27) is required; see README setup.</message>
+                </requireJavaVersion>
+                <requireMavenVersion>
+                  <version>[3.9,4)</version>
+                  <message>Use the Maven wrapper (mvnw / mvnw.cmd), which pins Maven 3.9.16.</message>
+                </requireMavenVersion>
+                <banDuplicatePomDependencyVersions/>
+              </rules>
+            </configuration>
+          </execution>
+        </executions>
+      </plugin>
+
+      <!-- Gate: format. google-java-format owns layout; zero diffs allowed. Fix with spotless:apply. -->
+      <plugin>
+        <groupId>com.diffplug.spotless</groupId>
+        <artifactId>spotless-maven-plugin</artifactId>
+        <configuration>
+          <java>
+            <includes>
+              <include>src/main/java/**/*.java</include>
+              <include>src/test/java/**/*.java</include>
+            </includes>
+            <googleJavaFormat>
+              <version>${google-java-format.version}</version>
+              <style>GOOGLE</style>
+              <reflowLongStrings>true</reflowLongStrings>
+              <formatJavadoc>true</formatJavadoc>
+            </googleJavaFormat>
+            <removeUnusedImports/>
+          </java>
+        </configuration>
+        <executions>
+          <execution>
+            <id>spotless-check</id>
+            <phase>validate</phase>
+            <goals>
+              <goal>check</goal>
+            </goals>
+          </execution>
+        </executions>
+      </plugin>
+
+      <!-- Gate: style. Google checks plus project rules (method 50 lines, file 400 lines, no field injection). -->
+      <plugin>
+        <groupId>org.apache.maven.plugins</groupId>
+        <artifactId>maven-checkstyle-plugin</artifactId>
+        <dependencies>
+          <dependency>
+            <groupId>com.puppycrawl.tools</groupId>
+            <artifactId>checkstyle</artifactId>
+            <version>${checkstyle.version}</version>
+          </dependency>
+        </dependencies>
+        <configuration>
+          <configLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/checkstyle.xml</configLocation>
+          <suppressionsLocation>${maven.multiModuleProjectDirectory}/config/checkstyle/suppressions.xml</suppressionsLocation>
+          <violationSeverity>warning</violationSeverity>
+          <includeTestSourceDirectory>true</includeTestSourceDirectory>
+          <consoleOutput>true</consoleOutput>
+          <failsOnError>true</failsOnError>
+          <linkXRef>false</linkXRef>
+        </configuration>
+        <executions>
+          <execution>
+            <id>checkstyle-check</id>
+            <phase>verify</phase>
+            <goals>
+              <goal>check</goal>
+            </goals>
+          </execution>
+        </executions>
+      </plugin>
+
+      <!-- Gate: coverage agent and report for every module; thresholds are set per module. -->
+      <plugin>
+        <groupId>org.jacoco</groupId>
+        <artifactId>jacoco-maven-plugin</artifactId>
+        <executions>
+          <execution>
+            <id>jacoco-prepare-agent</id>
+            <goals>
+              <goal>prepare-agent</goal>
+            </goals>
+          </execution>
+          <execution>
+            <id>jacoco-report</id>
+            <phase>verify</phase>
+            <goals>
+              <goal>report</goal>
+            </goals>
+          </execution>
+        </executions>
+      </plugin>
+    </plugins>
+  </build>
+
+  <profiles>
+    <!-- Opt-in performance smoke test. Run with: mvnw verify -Pperf -->
+    <profile>
+      <id>perf</id>
+      <properties>
+        <surefire.excludedGroups>none</surefire.excludedGroups>
+      </properties>
+    </profile>
+  </profiles>
+</project>
diff --git a/scripts/demo.ps1 b/scripts/demo.ps1
new file mode 100644
index 0000000..96cd960
--- /dev/null
+++ b/scripts/demo.ps1
@@ -0,0 +1,154 @@
+<#
+.SYNOPSIS
+  Walk the API against a running service and print one "step: expected -> actual" line per call.
+
+.DESCRIPTION
+  Steps, in order:
+    GET  /actuator/health                       expects 200
+    POST /api/v1/links {"url":"https://example.com/docs"} with the key, expects 201
+    GET  /{code} without following the redirect, expects 302 and shows the Location header
+    GET  /api/v1/links/{code}/stats with the key, expects 200
+    POST /api/v1/links without the key, expects 401
+    GET  /nope-404, expects 404
+
+  Works on Windows PowerShell 5.1 and PowerShell 7. Uses Invoke-WebRequest with -SkipHttpErrorCheck
+  when the cmdlet supports it and try/catch otherwise. The redirect step uses HttpWebRequest with
+  AllowAutoRedirect off, because Windows PowerShell 5.1 throws on a 3xx when -MaximumRedirection is 0.
+  Exits 1 when any step did not return the expected status.
+
+.PARAMETER BaseUrl
+  Base URL of the running service. Default http://localhost:8080.
+
+.PARAMETER ApiKey
+  Value for the X-API-Key header. Default dev-only-key-do-not-use, the dev profile default.
+
+.EXAMPLE
+  scripts/demo.ps1
+.EXAMPLE
+  scripts/demo.ps1 -BaseUrl http://localhost:9090 -ApiKey my-local-key
+#>
+[CmdletBinding()]
+param(
+  [string] $BaseUrl = 'http://localhost:8080',
+  [string] $ApiKey = 'dev-only-key-do-not-use'
+)
+
+$ErrorActionPreference = 'Continue'
+$BaseUrl = $BaseUrl.TrimEnd('/')
+$canSkipErrorCheck = (Get-Command Invoke-WebRequest).Parameters.ContainsKey('SkipHttpErrorCheck')
+
+function Get-HeaderValue($Response, [string] $Name) {
+  if ($null -eq $Response -or $null -eq $Response.Headers) { return $null }
+  try {
+    $v = $Response.Headers[$Name]
+    if ($null -ne $v) { return (@($v) -join ' ') }
+  } catch { }
+  try {
+    $p = $Response.Headers.PSObject.Properties[$Name]
+    if ($null -ne $p -and $null -ne $p.Value) { return "$($p.Value)" }
+  } catch { }
+  return $null
+}
+
+# Invoke-WebRequest path: used for every step except the redirect.
+function Send-WithCmdlet([string] $Method, [string] $Url, [hashtable] $Headers, [string] $Body) {
+  $request = @{ Uri = $Url; Method = $Method; Headers = $Headers; UseBasicParsing = $true; TimeoutSec = 15; ErrorAction = 'Stop' }
+  if ($Body) { $request['Body'] = $Body; $request['ContentType'] = 'application/json' }
+  if ($script:canSkipErrorCheck) { $request['SkipHttpErrorCheck'] = $true }
+  $out = @{ Status = $null; Location = $null; Content = $null; Note = '' }
+  try {
+    $response = Invoke-WebRequest @request
+    $out.Status   = [int] $response.StatusCode
+    $out.Location = Get-HeaderValue $response 'Location'
+    $out.Content  = $response.Content
+  } catch {
+    $errorResponse = $_.Exception.Response
+    if ($null -ne $errorResponse -and $null -ne $errorResponse.StatusCode) {
+      $out.Status   = [int] $errorResponse.StatusCode
+      $out.Location = Get-HeaderValue $errorResponse 'Location'
+    } else {
+      $out.Note = $_.Exception.Message
+    }
+  }
+  return $out
+}
+
+# HttpWebRequest path: the redirect step, with auto-redirect off so the 302 itself is observed.
+function Send-WithoutRedirect([string] $Method, [string] $Url, [hashtable] $Headers) {
+  $out = @{ Status = $null; Location = $null; Content = $null; Note = '' }
+  try {
+    $web = [System.Net.HttpWebRequest]::Create($Url)
+    $web.Method = $Method
+    $web.AllowAutoRedirect = $false
+    $web.Timeout = 15000
+    foreach ($name in $Headers.Keys) { $web.Headers[$name] = $Headers[$name] }
+    $raw = $web.GetResponse()
+    $out.Status   = [int] $raw.StatusCode
+    $out.Location = $raw.Headers['Location']
+    $raw.Close()
+  } catch {
+    $ex = $_.Exception
+    if ($null -ne $ex.InnerException -and $null -ne $ex.InnerException.Response) { $ex = $ex.InnerException }
+    if ($null -ne $ex.Response) {
+      $out.Status   = [int] $ex.Response.StatusCode
+      $out.Location = $ex.Response.Headers['Location']
+      $ex.Response.Close()
+    } else {
+      $out.Note = $ex.Message
+    }
+  }
+  return $out
+}
+
+function Invoke-Step {
+  param(
+    [string] $Label,
+    [string] $Method,
+    [string] $Url,
+    [int] $Expected,
+    [hashtable] $Headers = @{},
+    [string] $Body = $null,
+    [switch] $NoRedirect
+  )
+  if ($NoRedirect) { $r = Send-WithoutRedirect $Method $Url $Headers }
+  else { $r = Send-WithCmdlet $Method $Url $Headers $Body }
+
+  $actual = 'no response'
+  if ($null -ne $r.Status) { $actual = "$($r.Status)" }
+  elseif ($r.Note) { $actual = "no response ($($r.Note))" }
+  $ok = ($r.Status -eq $Expected)
+  $line = "{0} {1}: {2} -> {3}" -f $(if ($ok) { 'ok  ' } else { 'FAIL' }), $Label, $Expected, $actual
+  if ($r.Location) { $line += "    Location: $($r.Location)" }
+  Write-Host $line -ForegroundColor $(if ($ok) { 'Green' } else { 'Red' })
+  return [pscustomobject]@{ Ok = $ok; Status = $r.Status; Content = $r.Content; Location = $r.Location }
+}
+
+Write-Host "demo: base URL $BaseUrl" -ForegroundColor Cyan
+$steps = New-Object System.Collections.Generic.List[object]
+$authHeaders = @{ 'X-API-Key' = $ApiKey }
+$createBody  = '{"url":"https://example.com/docs"}'
+
+$steps.Add((Invoke-Step -Label 'GET /actuator/health' -Method GET -Url "$BaseUrl/actuator/health" -Expected 200))
+
+$create = Invoke-Step -Label 'POST /api/v1/links' -Method POST -Url "$BaseUrl/api/v1/links" -Expected 201 -Headers $authHeaders -Body $createBody
+$steps.Add($create)
+
+$code = $null
+if ($create.Content) {
+  try { $code = ($create.Content | ConvertFrom-Json).code } catch { $code = $null }
+}
+if (-not $code) {
+  $code = 'unknown'
+  Write-Host 'demo: the create response had no code; the redirect and stats steps use "unknown" and will not match.' -ForegroundColor Yellow
+}
+
+$steps.Add((Invoke-Step -Label "GET /$code (redirect not followed)" -Method GET -Url "$BaseUrl/$code" -Expected 302 -NoRedirect))
+$steps.Add((Invoke-Step -Label "GET /api/v1/links/$code/stats" -Method GET -Url "$BaseUrl/api/v1/links/$code/stats" -Expected 200 -Headers $authHeaders))
+$steps.Add((Invoke-Step -Label 'POST /api/v1/links without X-API-Key' -Method POST -Url "$BaseUrl/api/v1/links" -Expected 401 -Body $createBody))
+$steps.Add((Invoke-Step -Label 'GET /nope-404' -Method GET -Url "$BaseUrl/nope-404" -Expected 404))
+
+$failed = @($steps | Where-Object { -not $_.Ok }).Count
+Write-Host ''
+Write-Host "demo: $($steps.Count - $failed) of $($steps.Count) steps returned the expected status." -ForegroundColor $(if ($failed -eq 0) { 'Green' } else { 'Red' })
+if ($failed -eq 0) { exit 0 }
+exit 1
diff --git a/scripts/gate.ps1 b/scripts/gate.ps1
new file mode 100644
index 0000000..e2f4043
--- /dev/null
+++ b/scripts/gate.ps1
@@ -0,0 +1,197 @@
+<#
+.SYNOPSIS
+  Run the quality gates for a task and append the result to the ledger (lifecycle step 7).
+
+.DESCRIPTION
+  Runs .\mvnw.cmd -q spotless:apply, then .\mvnw.cmd -ntp verify (with -Pperf when -Perf is given).
+  Output is shown live and teed to harness/evidence/T-NNN/verify-N.log, where N increments per run so
+  red runs are kept as evidence. A gate record is then inserted at the end of the gates: list in
+  harness/ledger.yaml with the current commit, the UTC timestamp, the overall result from the Maven
+  exit code, and one result per gate key.
+
+  On a red run the failing Maven goal ("Failed to execute goal ...") is mapped to a gate key:
+    spotless -> format, checkstyle -> style, spotbugs -> sast, surefire -> tests
+    (or traceability when the failing project is harness-check), jacoco -> coverage.
+  Every other key is recorded as not-reached. perf is "skipped: opt-in profile not run" unless -Perf.
+  secrets is pass when the traceability tests passed, because the regex secret scan runs inside them.
+
+  Requires PowerShell 5.1 or later and git on PATH. The script exits with the Maven exit code.
+
+.PARAMETER TaskId
+  Task id in the form T-NNN, for example T-004.
+
+.PARAMETER Perf
+  Also run the opt-in perf profile (-Pperf) so RedirectLatencySmokeTest executes.
+
+.EXAMPLE
+  scripts/gate.ps1 T-004
+.EXAMPLE
+  scripts/gate.ps1 T-004 -Perf
+#>
+[CmdletBinding()]
+param(
+  [Parameter(Position = 0)]
+  [string] $TaskId,
+  [switch] $Perf
+)
+
+$ErrorActionPreference = 'Continue'
+
+function Fail([string] $Message) {
+  Write-Host "gate: $Message" -ForegroundColor Red
+  Write-Host 'Usage: scripts/gate.ps1 T-NNN [-Perf]    (example: scripts/gate.ps1 T-004)'
+  exit 1
+}
+
+if ([string]::IsNullOrWhiteSpace($TaskId)) { Fail 'the task id is missing.' }
+if ($TaskId -notmatch '^T-\d{3}$') { Fail "task id '$TaskId' does not match ^T-\d{3}$ (three digits, for example T-004)." }
+
+$repoRoot = Split-Path -Parent $PSScriptRoot
+Set-Location $repoRoot
+if (-not (Test-Path (Join-Path $repoRoot 'mvnw.cmd'))) { Fail 'mvnw.cmd was not found at the repository root.' }
+
+$ledgerPath  = Join-Path $repoRoot 'harness\ledger.yaml'
+$evidenceDir = Join-Path $repoRoot "harness\evidence\$TaskId"
+New-Item -ItemType Directory -Path $evidenceDir -Force | Out-Null
+
+# Next log number: verify-N.log with N one above the highest existing.
+$numbers = @(Get-ChildItem -Path $evidenceDir -Filter 'verify-*.log' -File |
+  ForEach-Object { if ($_.BaseName -match '^verify-(\d+)$') { [int] $Matches[1] } })
+$n = 1
+if ($numbers.Count -gt 0) { $n = ($numbers | Measure-Object -Maximum).Maximum + 1 }
+$logName = "verify-$n.log"
+$logPath = Join-Path $evidenceDir $logName
+$logRel  = "harness/evidence/$TaskId/$logName"
+
+$utf8  = New-Object System.Text.UTF8Encoding($false)
+$runAt = (Get-Date).ToUniversalTime().ToString('yyyy-MM-ddTHH:mm:ssZ')
+
+$writer = New-Object System.IO.StreamWriter($logPath, $false, $utf8)
+
+function Invoke-Logged([string] $CommandLine) {
+  # cmd /c merges stderr into stdout, so Windows PowerShell never turns Maven's stderr into error records.
+  Write-Host "gate: > $CommandLine" -ForegroundColor Cyan
+  $script:writer.WriteLine("### $CommandLine")
+  cmd /c "$CommandLine 2>&1" | ForEach-Object { Write-Host $_; $script:writer.WriteLine($_) }
+  $script:writer.Flush()
+  return $LASTEXITCODE
+}
+
+$verifyArgs = '-ntp verify'
+if ($Perf) { $verifyArgs = '-ntp -Pperf verify' }
+
+Write-Host "gate: $TaskId run $n at $runAt, log $logRel"
+$writer.WriteLine("# gate $TaskId run $n at $runAt")
+
+try {
+  $formatExit = Invoke-Logged '.\mvnw.cmd -q spotless:apply'
+  if ($formatExit -ne 0) {
+    Write-Host 'gate: spotless:apply failed; continuing to verify so the log records the cause.' -ForegroundColor Yellow
+  }
+  $verifyExit = Invoke-Logged ".\mvnw.cmd $verifyArgs"
+  $writer.WriteLine("# exit code $verifyExit")
+} finally {
+  $writer.Dispose()
+}
+
+# Map the result.
+$logText = [System.IO.File]::ReadAllText($logPath)
+$overall = 'fail'
+if ($verifyExit -eq 0) { $overall = 'pass' }
+
+$keys = @('format', 'style', 'sast', 'tests', 'coverage', 'traceability', 'secrets', 'perf')
+$results = @{}
+$failedGoal = $null
+$perfSkipped = 'skipped: opt-in profile not run'
+
+if ($overall -eq 'pass') {
+  foreach ($k in $keys) { $results[$k] = 'pass' }
+  if (-not $Perf) { $results['perf'] = $perfSkipped }
+} else {
+  foreach ($k in $keys) { $results[$k] = 'not-reached' }
+  if (-not $Perf) { $results['perf'] = $perfSkipped }
+  $m = [regex]::Match($logText, 'Failed to execute goal (?<coord>\S+)(?: \((?<exec>[^)]*)\))? on project (?<project>[^:\s]+)')
+  if ($m.Success) {
+    $coord    = $m.Groups['coord'].Value
+    $project  = $m.Groups['project'].Value
+    $parts    = $coord -split ':'
+    $artifact = $coord
+    if ($parts.Count -ge 2) { $artifact = $parts[1] }
+    $failedGoal = "$coord on project $project"
+    $key = $null
+    switch -Regex ($artifact) {
+      'spotless'          { $key = 'format'; break }
+      'checkstyle'        { $key = 'style'; break }
+      'spotbugs'          { $key = 'sast'; break }
+      'surefire|failsafe' { if ($project -eq 'harness-check') { $key = 'traceability' } else { $key = 'tests' }; break }
+      'jacoco'            { $key = 'coverage'; break }
+    }
+    if ($key) { $results[$key] = 'fail' }
+    if ($Perf -and $key -eq 'tests') {
+      $perfLine = [regex]::IsMatch($logText, '(?m)^.*RedirectLatencySmokeTest.*$')
+      $perfFail = [regex]::IsMatch($logText, '(?m)^.*(FAIL|ERROR).*RedirectLatencySmokeTest.*$|^.*RedirectLatencySmokeTest.*(FAIL|ERROR).*$')
+      if ($perfLine -and $perfFail) { $results['perf'] = 'fail' }
+    }
+  }
+}
+
+# Commit and tree state.
+$commit = (& git rev-parse --verify HEAD 2>$null)
+if ($LASTEXITCODE -ne 0 -or [string]::IsNullOrWhiteSpace("$commit")) { $commit = 'uncommitted' }
+$commit = "$commit".Trim()
+$tree = 'clean'
+if (@(& git status --porcelain 2>$null).Count -gt 0) { $tree = 'dirty' }
+
+# YAML block. Values holding a colon or hash are quoted so they stay strings.
+function Quote([string] $Value) {
+  if ($Value -match '[:#"]') { return '"' + $Value.Replace('"', '\"') + '"' }
+  return $Value
+}
+
+$block = New-Object System.Collections.Generic.List[string]
+$block.Add("  - task: $TaskId")
+$block.Add("    commit: `"$commit`"")
+$block.Add("    tree: $tree")
+$block.Add("    run_at: `"$runAt`"")
+$block.Add("    overall: $overall")
+$block.Add('    results:')
+foreach ($k in $keys) { $block.Add("      ${k}: $(Quote $results[$k])") }
+if ($failedGoal) { $block.Add("    failed_goal: $(Quote $failedGoal)") }
+$block.Add("    log: $logRel")
+
+# Insert the block at the end of the gates: list. Plain line handling, no YAML parser.
+if (-not (Test-Path $ledgerPath)) {
+  New-Item -ItemType Directory -Path (Split-Path -Parent $ledgerPath) -Force | Out-Null
+  [System.IO.File]::WriteAllText($ledgerPath, "entries: []`ngates: []`nsignoffs: []`n", $utf8)
+}
+$raw = [System.IO.File]::ReadAllText($ledgerPath)
+$nl = "`n"
+if ($raw -match "`r`n") { $nl = "`r`n" }
+$lines = New-Object System.Collections.Generic.List[string]
+$lines.AddRange([string[]] @($raw -split "`r?`n"))
+while ($lines.Count -gt 0 -and $lines[$lines.Count - 1] -eq '') { $lines.RemoveAt($lines.Count - 1) }
+
+$gatesIdx = -1
+for ($i = 0; $i -lt $lines.Count; $i++) {
+  if ($lines[$i] -match '^gates:\s*(\[\s*\])?\s*(#.*)?$') { $gatesIdx = $i; break }
+}
+if ($gatesIdx -lt 0) {
+  $lines.Add('gates:')
+  $insertAt = $lines.Count
+} else {
+  if ($lines[$gatesIdx] -match '^gates:\s*\[\s*\]') { $lines[$gatesIdx] = 'gates:' }
+  $insertAt = $lines.Count
+  for ($j = $gatesIdx + 1; $j -lt $lines.Count; $j++) {
+    if ($lines[$j] -match '^[A-Za-z_][A-Za-z0-9_-]*:') { $insertAt = $j; break }
+  }
+}
+$lines.InsertRange($insertAt, $block)
+[System.IO.File]::WriteAllText($ledgerPath, (($lines -join $nl) + $nl), $utf8)
+
+Write-Host ''
+Write-Host "gate: $TaskId run $n overall $overall (commit $commit, tree $tree)" -ForegroundColor $(if ($overall -eq 'pass') { 'Green' } else { 'Red' })
+foreach ($k in $keys) { Write-Host ("  {0,-13} {1}" -f $k, $results[$k]) }
+if ($failedGoal) { Write-Host "  failed goal   $failedGoal" }
+Write-Host "  log           $logRel"
+Write-Host '  ledger        harness/ledger.yaml (gate record appended)'
+exit $verifyExit
diff --git a/scripts/hooks/commit-msg b/scripts/hooks/commit-msg
new file mode 100644
index 0000000..8a49ea5
--- /dev/null
+++ b/scripts/hooks/commit-msg
@@ -0,0 +1,63 @@
+#!/bin/sh
+# commit-msg hook: Conventional Commits header plus a Task trailer (design section 4.4).
+#
+# Enable once per clone:   git config core.hooksPath scripts/hooks
+# Runs under Git for Windows sh and any POSIX sh. Needs LF line endings and the executable bit
+# (git update-index --chmod=+x scripts/hooks/commit-msg) for Linux and macOS clones.
+#
+# Rules:
+#   1. The first non-comment line matches
+#      ^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$
+#   2. Unless the commit is a merge, a trailer line matches ^Task: T-[0-9]{3}$
+# Merge commits (MERGE_HEAD present, or a header starting with "Merge ") are exempt from both rules.
+
+msg_file=$1
+if [ -z "$msg_file" ] || [ ! -r "$msg_file" ]; then
+  echo "commit-msg: cannot read the commit message file '$msg_file'" >&2
+  exit 1
+fi
+
+# Drop carriage returns and comment lines, as git will before it records the message.
+body=$(tr -d '\r' < "$msg_file" | grep -v '^#')
+header=$(printf '%s\n' "$body" | sed '/^[[:space:]]*$/d' | head -n 1)
+
+if git rev-parse -q --verify MERGE_HEAD >/dev/null 2>&1; then
+  exit 0
+fi
+case "$header" in
+  "Merge "*) exit 0 ;;
+esac
+
+header_re='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?!?: .{1,72}$'
+trailer_re='^Task: T-[0-9]{3}$'
+failed=0
+
+if ! printf '%s\n' "$header" | grep -Eq "$header_re"; then
+  echo "commit-msg: the first line is not a Conventional Commit header." >&2
+  echo "  got:      $header" >&2
+  echo "  expected: <type>(<scope>)?!?: <description of 1 to 72 characters>" >&2
+  echo "  types:    feat fix docs style refactor perf test build ci chore revert" >&2
+  echo "  scope:    lowercase letters, digits, and hyphens, for example (redirect)" >&2
+  failed=1
+fi
+
+if ! printf '%s\n' "$body" | grep -Eq "$trailer_re"; then
+  echo "commit-msg: no Task trailer found." >&2
+  echo "  add a final line exactly like:  Task: T-004" >&2
+  echo "  the id must exist as harness/tasks/T-004.yaml; harness-check verifies it in the build" >&2
+  failed=1
+fi
+
+if [ "$failed" -ne 0 ]; then
+  echo "" >&2
+  echo "Example:" >&2
+  echo "  feat(redirect): return 410 for expired links" >&2
+  echo "" >&2
+  echo "  Expired rows are kept so stats keep working; the controller sets Cache-Control: no-store." >&2
+  echo "" >&2
+  echo "  Task: T-102" >&2
+  echo "" >&2
+  echo "No AI product names in commit messages; tool and model live in the ledger entry the trailer resolves to." >&2
+  exit 1
+fi
+exit 0
diff --git a/scripts/report.ps1 b/scripts/report.ps1
new file mode 100644
index 0000000..965be61
--- /dev/null
+++ b/scripts/report.ps1
@@ -0,0 +1,49 @@
+<#
+.SYNOPSIS
+  Regenerate the traceability report and snapshot it into docs/reports/ (lifecycle step 10).
+
+.DESCRIPTION
+  Runs .\mvnw.cmd -q -pl harness-check test, then copies harness-check/target/traceability.md to
+  docs/reports/traceability.md, creating the folder when needed. The report is deterministic and
+  carries no timestamps, so the copy only changes when the harness data changes.
+
+  Exits with the Maven exit code. When the harness-check tests fail, the report is still copied if
+  it was produced, and a warning says the snapshot reflects a failing state.
+
+.EXAMPLE
+  scripts/report.ps1
+#>
+[CmdletBinding()]
+param()
+
+$ErrorActionPreference = 'Continue'
+
+$repoRoot = Split-Path -Parent $PSScriptRoot
+Set-Location $repoRoot
+if (-not (Test-Path (Join-Path $repoRoot 'mvnw.cmd'))) {
+  Write-Host 'report: mvnw.cmd was not found at the repository root.' -ForegroundColor Red
+  exit 1
+}
+
+Write-Host 'report: > .\mvnw.cmd -q -pl harness-check test' -ForegroundColor Cyan
+cmd /c ".\mvnw.cmd -q -pl harness-check test 2>&1" | ForEach-Object { Write-Host $_ }
+$mavenExit = $LASTEXITCODE
+
+$source    = Join-Path $repoRoot 'harness-check\target\traceability.md'
+$targetDir = Join-Path $repoRoot 'docs\reports'
+$target    = Join-Path $targetDir 'traceability.md'
+
+if (-not (Test-Path $source)) {
+  Write-Host "report: harness-check/target/traceability.md was not produced (Maven exit code $mavenExit)." -ForegroundColor Red
+  if ($mavenExit -eq 0) { exit 1 }
+  exit $mavenExit
+}
+
+New-Item -ItemType Directory -Path $targetDir -Force | Out-Null
+Copy-Item -Path $source -Destination $target -Force
+Write-Host 'report: copied harness-check/target/traceability.md to docs/reports/traceability.md' -ForegroundColor Green
+
+if ($mavenExit -ne 0) {
+  Write-Host "report: the harness-check tests failed (exit code $mavenExit); the snapshot reflects a failing state." -ForegroundColor Yellow
+}
+exit $mavenExit
diff --git a/scripts/run.ps1 b/scripts/run.ps1
