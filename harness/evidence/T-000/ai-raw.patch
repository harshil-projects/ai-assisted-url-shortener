diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpec.java b/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpec.java
new file mode 100644
index 0000000..3ef9251
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpec.java
@@ -0,0 +1,112 @@
+package dev.harshil.shortener.harness;
+
+import java.nio.file.Path;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * One task specification read from {@code harness/tasks/T-NNN.yaml}. Fields missing from the file
+ * are null or empty here; rule HC-01 reports them instead of the loader failing.
+ *
+ * @param file the YAML file the spec was read from
+ * @param fileStem the file name without its {@code .yaml} extension
+ * @param id the declared task id, or null when missing
+ * @param title the task title, or null when missing
+ * @param requirement the requirement id, or null when missing
+ * @param activities the declared activities, possibly empty
+ * @param impact {@code high} or {@code normal}, or null when missing
+ * @param impactReasons the impact reason codes, possibly empty
+ * @param status the lifecycle status, or null when missing
+ * @param dependsOn the ids of tasks this one depends on
+ * @param intent the intent text, or null when missing
+ * @param constraints the constraints list, possibly empty
+ * @param acceptanceCriteria the acceptance criteria list, possibly empty
+ * @param hasTechnicalContext whether a {@code technical_context} mapping is present
+ * @param technicalContextFiles the files listed under {@code technical_context}
+ * @param verification the verification list, possibly empty
+ * @param impactAnalysis the optional impact analysis path, read from the nested key {@code
+ *     technical_context.impact_analysis} or the top-level key, given as a bare path or as the
+ *     {@code document} value of a mapping
+ */
+public record TaskSpec(
+    Path file,
+    String fileStem,
+    String id,
+    String title,
+    String requirement,
+    List<String> activities,
+    String impact,
+    List<String> impactReasons,
+    String status,
+    List<String> dependsOn,
+    String intent,
+    List<String> constraints,
+    List<String> acceptanceCriteria,
+    boolean hasTechnicalContext,
+    List<String> technicalContextFiles,
+    List<String> verification,
+    String impactAnalysis) {
+
+  /** Builds a spec from the raw YAML mapping of one task file. */
+  static TaskSpec fromYaml(Path file, Map<String, Object> yaml) {
+    String name = file.getFileName().toString();
+    String stem = name.endsWith(".yaml") ? name.substring(0, name.length() - 5) : name;
+    Object context = yaml.get("technical_context");
+    Map<String, Object> contextMap = YamlValues.asMap(context);
+    return new TaskSpec(
+        file,
+        stem,
+        YamlValues.scalar(yaml, "id"),
+        YamlValues.scalar(yaml, "title"),
+        YamlValues.scalar(yaml, "requirement"),
+        YamlValues.scalars(yaml, "activities"),
+        YamlValues.scalar(yaml, "impact"),
+        YamlValues.scalars(yaml, "impact_reasons"),
+        YamlValues.scalar(yaml, "status"),
+        YamlValues.scalars(yaml, "depends_on"),
+        YamlValues.scalar(yaml, "intent"),
+        YamlValues.scalars(yaml, "constraints"),
+        YamlValues.scalars(yaml, "acceptance_criteria"),
+        context instanceof Map<?, ?>,
+        YamlValues.scalars(contextMap, "files"),
+        YamlValues.scalars(yaml, "verification"),
+        impactAnalysisPath(contextMap, yaml));
+  }
+
+  /**
+   * The impact analysis path: {@code technical_context.impact_analysis} first, then the top-level
+   * key. Either may be a bare path or a mapping whose {@code document} key holds the path.
+   */
+  private static String impactAnalysisPath(Map<String, Object> context, Map<String, Object> yaml) {
+    for (Map<String, Object> holder : List.of(context, yaml)) {
+      Object value = holder.get("impact_analysis");
+      if (value instanceof Map<?, ?>) {
+        value = YamlValues.asMap(value).get("document");
+      }
+      if (value != null && !(value instanceof Map<?, ?>) && !(value instanceof Iterable<?>)) {
+        return value.toString();
+      }
+    }
+    return null;
+  }
+
+  /** The id used to address this task: the declared id, or the file stem when the id is missing. */
+  public String key() {
+    return id != null && !id.isBlank() ? id : fileStem;
+  }
+
+  /** True when the status is {@code done}. */
+  public boolean isDone() {
+    return Vocabulary.DONE.equals(status);
+  }
+
+  /** True when the impact is {@code high}. */
+  public boolean isHighImpact() {
+    return Vocabulary.HIGH.equals(impact);
+  }
+
+  /** True when the activities are exactly the single activity {@code document}. */
+  public boolean isDocumentOnly() {
+    return activities.equals(List.of(Vocabulary.DOCUMENT));
+  }
+}
diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpecChecks.java b/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpecChecks.java
new file mode 100644
index 0000000..e89d246
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/TaskSpecChecks.java
@@ -0,0 +1,152 @@
+package dev.harshil.shortener.harness;
+
+import java.util.ArrayDeque;
+import java.util.ArrayList;
+import java.util.Deque;
+import java.util.HashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.TreeMap;
+
+/** Field and dependency checks over task specs, behind rules HC-01 and HC-02. */
+final class TaskSpecChecks {
+
+  private TaskSpecChecks() {}
+
+  /** HC-01 checks for one task: required fields, enum values, and id matching the file name. */
+  static List<Violation> requiredFields(TaskSpec task) {
+    List<Violation> out = new ArrayList<>();
+    String subject = task.key();
+    requireText(out, subject, "id", task.id());
+    if (task.id() != null && !task.id().equals(task.fileStem())) {
+      out.add(hc01(subject, "id '" + task.id() + "' does not match file name " + task.fileStem()));
+    }
+    requireText(out, subject, "title", task.title());
+    requireText(out, subject, "requirement", task.requirement());
+    requireEnumList(out, subject, "activities", task.activities(), Vocabulary.ACTIVITIES);
+    requireEnum(out, subject, "impact", task.impact(), Vocabulary.IMPACTS);
+    checkImpactReasons(out, task);
+    requireEnum(out, subject, "status", task.status(), Vocabulary.STATUSES);
+    requireText(out, subject, "intent", task.intent());
+    requireNonEmpty(out, subject, "constraints", task.constraints());
+    requireNonEmpty(out, subject, "acceptance_criteria", task.acceptanceCriteria());
+    if (!task.hasTechnicalContext()) {
+      out.add(hc01(subject, "missing required field technical_context"));
+    } else {
+      requireNonEmpty(out, subject, "technical_context.files", task.technicalContextFiles());
+    }
+    requireNonEmpty(out, subject, "verification", task.verification());
+    return out;
+  }
+
+  /** HC-02 checks over all tasks: dependencies exist and form no cycle. */
+  static List<Violation> dependencies(List<TaskSpec> tasks) {
+    Map<String, List<String>> edges = new TreeMap<>();
+    for (TaskSpec task : tasks) {
+      edges.put(task.key(), task.dependsOn());
+    }
+    List<Violation> out = new ArrayList<>();
+    for (TaskSpec task : tasks) {
+      for (String dependency : task.dependsOn()) {
+        if (!edges.containsKey(dependency)) {
+          out.add(hc02(task.key(), "depends_on references missing task " + dependency));
+        }
+      }
+    }
+    Set<String> finished = new HashSet<>();
+    for (String start : edges.keySet()) {
+      visit(start, edges, new ArrayDeque<>(), finished, out);
+    }
+    return out;
+  }
+
+  private static void visit(
+      String node,
+      Map<String, List<String>> edges,
+      Deque<String> path,
+      Set<String> finished,
+      List<Violation> out) {
+    if (finished.contains(node)) {
+      return;
+    }
+    if (path.contains(node)) {
+      out.add(hc02(node, "depends_on forms a cycle: " + describeCycle(path, node)));
+      return;
+    }
+    path.addLast(node);
+    for (String dependency : edges.getOrDefault(node, List.of())) {
+      visit(dependency, edges, path, finished, out);
+    }
+    path.removeLast();
+    finished.add(node);
+  }
+
+  private static String describeCycle(Deque<String> path, String repeated) {
+    List<String> cycle = new ArrayList<>();
+    boolean started = false;
+    for (String node : path) {
+      started = started || node.equals(repeated);
+      if (started) {
+        cycle.add(node);
+      }
+    }
+    cycle.add(repeated);
+    return String.join(" -> ", cycle);
+  }
+
+  private static void checkImpactReasons(List<Violation> out, TaskSpec task) {
+    if (task.isHighImpact() && task.impactReasons().isEmpty()) {
+      out.add(hc01(task.key(), "impact_reasons is required when impact is high"));
+    }
+    for (String reason : task.impactReasons()) {
+      if (!Vocabulary.IMPACT_REASONS.contains(reason)) {
+        out.add(hc01(task.key(), "impact_reasons has unknown value '" + reason + "'"));
+      }
+    }
+  }
+
+  private static void requireText(List<Violation> out, String subject, String field, String value) {
+    if (value == null || value.isBlank()) {
+      out.add(hc01(subject, "missing required field " + field));
+    }
+  }
+
+  private static void requireNonEmpty(
+      List<Violation> out, String subject, String field, List<String> values) {
+    if (values.isEmpty()) {
+      out.add(hc01(subject, field + " must be a non-empty list"));
+    }
+  }
+
+  private static void requireEnum(
+      List<Violation> out, String subject, String field, String value, Set<String> allowed) {
+    if (value == null || value.isBlank()) {
+      out.add(hc01(subject, "missing required field " + field));
+    } else if (!allowed.contains(value)) {
+      out.add(hc01(subject, unknownValue(field, value, allowed)));
+    }
+  }
+
+  private static void requireEnumList(
+      List<Violation> out, String subject, String field, List<String> values, Set<String> allowed) {
+    requireNonEmpty(out, subject, field, values);
+    for (String value : values) {
+      if (!allowed.contains(value)) {
+        out.add(hc01(subject, unknownValue(field, value, allowed)));
+      }
+    }
+  }
+
+  private static String unknownValue(String field, String value, Set<String> allowed) {
+    return field + " has unknown value '" + value + "', allowed: " + Vocabulary.describe(allowed);
+  }
+
+  private static Violation hc01(String subject, String message) {
+    return new Violation("HC-01", subject, message);
+  }
+
+  private static Violation hc02(String subject, String message) {
+    return new Violation("HC-02", subject, message);
+  }
+}
diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/TraceabilityReport.java b/harness-check/src/main/java/dev/harshil/shortener/harness/TraceabilityReport.java
new file mode 100644
index 0000000..388ecf5
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/TraceabilityReport.java
@@ -0,0 +1,199 @@
+package dev.harshil.shortener.harness;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Locale;
+import java.util.OptionalDouble;
+import java.util.function.Predicate;
+import java.util.function.ToLongFunction;
+import java.util.regex.Pattern;
+import java.util.stream.Stream;
+
+/**
+ * Writes the traceability report as deterministic Markdown: no timestamps, tasks sorted by id,
+ * computed figures labelled apart from engineer-asserted ones.
+ */
+public final class TraceabilityReport {
+
+  /** The last line of every report, naming which figures are asserted and which are computed. */
+  public static final String CLOSING_LINE =
+      "Statuses and rationale are engineer-asserted; kept ratios and counts are computed.";
+
+  private static final Pattern PROMPT_VERSION = Pattern.compile("v\\d+\\.md");
+  private static final String NOT_AVAILABLE = "n/a";
+  private static final String ASSERTED = "engineer-asserted";
+  private static final String COMPUTED = "computed";
+
+  private record Row(
+      String id,
+      String activities,
+      String impact,
+      String status,
+      long promptVersions,
+      long generated,
+      long edited,
+      long rejected,
+      OptionalDouble keptRatio,
+      String gate,
+      boolean signedOff,
+      long commits) {}
+
+  private TraceabilityReport() {}
+
+  /** Renders the report and writes it to the target file, creating parent directories. */
+  public static Path write(HarnessRepo repo, GitLog gitLog, Path target) throws IOException {
+    Path absolute = target.toAbsolutePath().normalize();
+    Files.createDirectories(absolute.getParent());
+    Files.writeString(absolute, render(repo, gitLog), StandardCharsets.UTF_8);
+    return absolute;
+  }
+
+  /** Renders the report as Markdown. */
+  public static String render(HarnessRepo repo, GitLog gitLog) {
+    List<Row> rows = new ArrayList<>();
+    for (TaskSpec task : repo.tasks()) {
+      rows.add(row(repo, gitLog, task));
+    }
+    StringBuilder md = new StringBuilder();
+    md.append("# Traceability report\n\n");
+    md.append("Generated by harness-check from the data under `harness/`, the working tree, and ");
+    md.append("git history after the `baseline` tag.\n\n");
+    appendTaskTable(md, rows, gitLog);
+    appendSummary(md, rows, gitLog);
+    md.append(CLOSING_LINE).append('\n');
+    return md.toString();
+  }
+
+  private static Row row(HarnessRepo repo, GitLog gitLog, TaskSpec task) {
+    String id = task.key();
+    List<LedgerEntry> entries = repo.ledger().entriesFor(id);
+    List<GateRecord> gates = repo.ledger().gatesFor(id);
+    return new Row(
+        id,
+        task.activities().isEmpty() ? NOT_AVAILABLE : String.join(", ", task.activities()),
+        orNotAvailable(task.impact()),
+        orNotAvailable(task.status()),
+        promptVersions(repo.promptsDir().resolve(id)),
+        countFiles(entries, "generated"),
+        countFiles(entries, "edited"),
+        countFiles(entries, Vocabulary.REJECTED),
+        KeptRatio.compute(repo, id, entries),
+        gates.isEmpty() ? "none" : orNotAvailable(gates.get(gates.size() - 1).overall()),
+        !repo.ledger().signoffsFor(id).isEmpty(),
+        gitLog.commitsFor(id).size());
+  }
+
+  private static void appendTaskTable(StringBuilder md, List<Row> rows, GitLog gitLog) {
+    md.append("## Tasks\n\n");
+    md.append("| Task | Activities | Impact | Status | Prompt versions | Generated | Edited ");
+    md.append("| Rejected | Kept ratio | Gate | Sign-off | Commits |\n");
+    md.append("|---|---|---|---|---|---|---|---|---|---|---|---|\n");
+    for (Row row : rows) {
+      md.append("| ").append(row.id());
+      md.append(" | ").append(row.activities());
+      md.append(" | ").append(row.impact());
+      md.append(" | ").append(row.status());
+      md.append(" | ").append(row.promptVersions());
+      md.append(" | ").append(row.generated());
+      md.append(" | ").append(row.edited());
+      md.append(" | ").append(row.rejected());
+      md.append(" | ").append(ratio(row.keptRatio()));
+      md.append(" | ").append(row.gate());
+      md.append(" | ").append(row.signedOff() ? "yes" : "no");
+      md.append(" | ").append(gitLog.skipped() ? NOT_AVAILABLE : String.valueOf(row.commits()));
+      md.append(" |\n");
+    }
+    if (rows.isEmpty()) {
+      md.append("\nNo task specs found under `harness/tasks/`.\n");
+    }
+    md.append('\n');
+  }
+
+  private static void appendSummary(StringBuilder md, List<Row> rows, GitLog gitLog) {
+    md.append("## Summary\n\n");
+    md.append("| Measure | Value | Source |\n|---|---|---|\n");
+    summaryRow(md, "Tasks", String.valueOf(rows.size()), COMPUTED);
+    String done = countRows(rows, row -> Vocabulary.DONE.equals(row.status()));
+    summaryRow(md, "Tasks done", done, ASSERTED);
+    String high = countRows(rows, row -> Vocabulary.HIGH.equals(row.impact()));
+    summaryRow(md, "High-impact tasks", high, ASSERTED);
+    summaryRow(md, "Tasks with sign-off", countRows(rows, Row::signedOff), COMPUTED);
+    appendFileFigures(md, rows);
+    summaryRow(md, "Mean kept ratio", ratio(meanKeptRatio(rows)), COMPUTED);
+    String commits =
+        gitLog.skipped()
+            ? NOT_AVAILABLE + " (" + gitLog.skipReason() + ")"
+            : String.valueOf(gitLog.commits().size());
+    summaryRow(md, "Commits after baseline", commits, COMPUTED);
+    md.append('\n');
+  }
+
+  private static void appendFileFigures(StringBuilder md, List<Row> rows) {
+    long generated = sum(rows, Row::generated);
+    summaryRow(md, "Files kept as generated", String.valueOf(generated), ASSERTED);
+    long edited = sum(rows, Row::edited);
+    summaryRow(md, "Files edited", String.valueOf(edited), ASSERTED);
+    long rejected = sum(rows, Row::rejected);
+    summaryRow(md, "Files rejected", String.valueOf(rejected), ASSERTED);
+    long files = generated + edited + rejected;
+    summaryRow(md, "Acceptance ratio", share(generated, files), COMPUTED);
+    summaryRow(md, "Edit ratio", share(edited, files), COMPUTED);
+    summaryRow(md, "Rejection ratio", share(rejected, files), COMPUTED);
+  }
+
+  private static void summaryRow(StringBuilder md, String measure, String value, String source) {
+    md.append("| ").append(measure).append(" | ").append(value).append(" | ").append(source);
+    md.append(" |\n");
+  }
+
+  private static long promptVersions(Path directory) {
+    if (!Files.isDirectory(directory)) {
+      return 0;
+    }
+    try (Stream<Path> files = Files.list(directory)) {
+      return files
+          .filter(file -> PROMPT_VERSION.matcher(file.getFileName().toString()).matches())
+          .count();
+    } catch (IOException e) {
+      return 0;
+    }
+  }
+
+  private static OptionalDouble meanKeptRatio(List<Row> rows) {
+    return rows.stream()
+        .map(Row::keptRatio)
+        .filter(OptionalDouble::isPresent)
+        .mapToDouble(OptionalDouble::getAsDouble)
+        .average();
+  }
+
+  private static long countFiles(List<LedgerEntry> entries, String status) {
+    return entries.stream().mapToLong(entry -> entry.countFiles(status)).sum();
+  }
+
+  private static String countRows(List<Row> rows, Predicate<Row> predicate) {
+    return String.valueOf(rows.stream().filter(predicate).count());
+  }
+
+  private static long sum(List<Row> rows, ToLongFunction<Row> field) {
+    return rows.stream().mapToLong(field).sum();
+  }
+
+  private static String share(long part, long whole) {
+    return whole == 0 ? NOT_AVAILABLE : ratio(OptionalDouble.of((double) part / whole));
+  }
+
+  private static String ratio(OptionalDouble value) {
+    return value.isPresent()
+        ? String.format(Locale.ROOT, "%.2f", value.getAsDouble())
+        : NOT_AVAILABLE;
+  }
+
+  private static String orNotAvailable(String value) {
+    return value == null || value.isBlank() ? NOT_AVAILABLE : value;
+  }
+}
