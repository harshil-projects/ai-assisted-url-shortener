+# Production profile. Every secret and endpoint comes from the environment; nothing here is a default
+# that could be shipped by accident.
+spring.datasource.url=${SPRING_DATASOURCE_URL}
+spring.datasource.username=${SPRING_DATASOURCE_USERNAME:}
+spring.datasource.password=${SPRING_DATASOURCE_PASSWORD:}
+spring.h2.console.enabled=false
+
+# Required. AppProperties is @Validated with @NotBlank, so startup fails fast when this is empty.
+app.api-key=${APP_API_KEY:}
+app.ratelimit.create.capacity=20
+app.security.actuator-requires-api-key=true
+
+management.endpoint.health.show-details=when-authorized
+logging.structured.format.console=ecs
+logging.level.dev.harshil.shortener=INFO
diff --git a/url-shortener/src/main/resources/application.properties b/url-shortener/src/main/resources/application.properties
new file mode 100644
index 0000000..f3b223d
--- /dev/null
+++ b/url-shortener/src/main/resources/application.properties
@@ -0,0 +1,40 @@
+# Common settings for every profile. Profile files override: application-dev, application-prod,
+# and src/test/resources/application-test. The dev profile is active when none is chosen.
+spring.application.name=url-shortener
+spring.profiles.default=dev
+
+# Persistence. Flyway owns the schema; Hibernate only validates it at startup (ADR 0002).
+spring.jpa.open-in-view=false
+spring.jpa.hibernate.ddl-auto=validate
+spring.flyway.locations=classpath:db/migration
+spring.datasource.hikari.maximum-pool-size=10
+# Fail fast with 503 + Retry-After instead of hanging when the database is unreachable.
+spring.datasource.hikari.connection-timeout=2000
+
+# Threads. Virtual threads stay off: the H2 JDBC driver synchronises around each statement and
+# pins carrier threads on Java 21 (JEP 491 lands later). One property flips it on PostgreSQL.
+spring.threads.virtual.enabled=false
+
+# Shutdown. Graceful is the Boot default; stated here because the click executor drains during it.
+server.shutdown=graceful
+spring.lifecycle.timeout-per-shutdown-phase=20s
+# Trust no proxy headers unless deployed behind one you control (see docs/reference/api.md).
+server.forward-headers-strategy=NONE
+
+# Observability
+management.endpoints.web.exposure.include=health,info,metrics,prometheus
+management.endpoint.health.probes.enabled=true
+management.endpoint.health.show-details=never
+management.info.build.enabled=true
+management.info.java.enabled=true
+
+# Application settings (bound to AppProperties)
+# Optional public base URL used to build shortUrl; when empty the request host is used.
+app.base-url=
+# Create-endpoint rate limit per client address: tokens per period.
+app.ratelimit.create.capacity=20
+app.ratelimit.create.period=1m
+# Maximum request body accepted on /api/v1/** (bytes).
+app.request.max-bytes=16384
+# Whether /actuator/info, /metrics and /prometheus need the API key (health never does).
+app.security.actuator-requires-api-key=true
