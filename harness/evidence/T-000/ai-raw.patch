+package dev.harshil.shortener.harness;
+
+import static dev.harshil.shortener.harness.HarnessTestSupport.assertNoViolations;
+import static dev.harshil.shortener.harness.HarnessTestSupport.repo;
+
+import org.junit.jupiter.api.Assumptions;
+import org.junit.jupiter.api.Test;
+
+/**
+ * Rules that need git history after the {@code baseline} tag: HC-07 and HC-12. Both are skipped,
+ * with the reason printed, when {@code .git} is absent, git is not on the PATH, or the tag does not
+ * exist.
+ */
+class GitRulesTest {
+
+  @Test
+  void hc07_commitsAfterBaselineCarryTaskTrailersNamingExistingTasks() {
+    HarnessRepo repo = repo();
+    GitLog gitLog = GitLog.load(repo.root());
+    assumeHistory("HC-07", gitLog);
+    assertNoViolations("HC-07", Rules.hc07(repo, gitLog));
+  }
+
+  @Test
+  void hc12_changedMainSourceFilesWerePredictedByImpactAnalysis() {
+    HarnessRepo repo = repo();
+    GitLog gitLog = GitLog.load(repo.root());
+    assumeHistory("HC-12", gitLog);
+    assertNoViolations("HC-12", Rules.hc12(repo, gitLog));
+  }
+
+  private static void assumeHistory(String rule, GitLog gitLog) {
+    if (gitLog.skipped()) {
+      System.out.println(rule + " skipped: " + gitLog.skipReason());
+    }
+    Assumptions.assumeFalse(gitLog.skipped(), () -> rule + " skipped: " + gitLog.skipReason());
+  }
+}
diff --git a/harness-check/src/test/java/dev/harshil/shortener/harness/HarnessTestSupport.java b/harness-check/src/test/java/dev/harshil/shortener/harness/HarnessTestSupport.java
new file mode 100644
index 0000000..e621db8
--- /dev/null
+++ b/harness-check/src/test/java/dev/harshil/shortener/harness/HarnessTestSupport.java
@@ -0,0 +1,28 @@
+package dev.harshil.shortener.harness;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.stream.Collectors;
+
+/** Shared helpers for the rule tests: the repository under test and the violation assertion. */
+final class HarnessTestSupport {
+
+  private HarnessTestSupport() {}
+
+  /** The harness of the repository named by the {@code harness.root} system property. */
+  static HarnessRepo repo() {
+    return HarnessRepo.open(HarnessRepo.defaultRoot());
+  }
+
+  /** Fails with every violation listed when the list is not empty. */
+  static void assertNoViolations(String rule, List<Violation> violations) {
+    assertThat(violations).withFailMessage(() -> describe(rule, violations)).isEmpty();
+  }
+
+  private static String describe(String rule, List<Violation> violations) {
+    String listed =
+        violations.stream().map(Violation::toString).collect(Collectors.joining("\n  "));
+    return rule + ": " + violations.size() + " violation(s)\n  " + listed;
+  }
+}
