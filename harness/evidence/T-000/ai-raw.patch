+package dev.harshil.shortener.harness;
+
+import java.util.List;
+import java.util.Set;
+
+/** The closed vocabularies of the harness data, as fixed by the design document. */
+final class Vocabulary {
+
+  static final Set<String> ACTIVITIES =
+      Set.of("implement", "debug", "refactor", "test-gen", "document", "review-prep");
+
+  static final Set<String> IMPACTS = Set.of("high", "normal");
+
+  static final Set<String> IMPACT_REASONS =
+      Set.of("schema", "security", "dependency", "data-deletion");
+
+  static final Set<String> STATUSES = Set.of("todo", "in-progress", "done", "dropped");
+
+  static final Set<String> FILE_STATUSES = Set.of("generated", "edited", "rejected");
+
+  /** Every key a passing gate record must report, in report order. */
+  static final List<String> GATE_KEYS =
+      List.of("format", "style", "sast", "tests", "coverage", "traceability", "secrets", "perf");
+
+  static final String DOCUMENT = "document";
+
+  static final String DONE = "done";
+
+  static final String HIGH = "high";
+
+  static final String PASS = "pass";
+
+  static final String REJECTED = "rejected";
+
+  private Vocabulary() {}
+
+  /** Sorted, comma-separated rendering of an allowed set for messages. */
+  static String describe(Set<String> allowed) {
+    return String.join(", ", allowed.stream().sorted().toList());
+  }
+}
diff --git a/harness-check/src/main/java/dev/harshil/shortener/harness/YamlValues.java b/harness-check/src/main/java/dev/harshil/shortener/harness/YamlValues.java
new file mode 100644
index 0000000..6d8fd30
--- /dev/null
+++ b/harness-check/src/main/java/dev/harshil/shortener/harness/YamlValues.java
@@ -0,0 +1,72 @@
+package dev.harshil.shortener.harness;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+
+/**
+ * Tolerant read access to the untyped maps and lists produced by SnakeYAML. Missing keys and wrong
+ * types yield nulls or empty collections so that rules, not the loader, report them.
+ */
+final class YamlValues {
+
+  private YamlValues() {}
+
+  /** Returns the value as a string-keyed map when it is a map, otherwise an empty map. */
+  static Map<String, Object> asMap(Object value) {
+    if (!(value instanceof Map<?, ?> map)) {
+      return Map.of();
+    }
+    Map<String, Object> result = new LinkedHashMap<>();
+    map.forEach((key, item) -> result.put(String.valueOf(key), item));
+    return result;
+  }
+
+  /** Returns the value as a list when it is a collection, otherwise an empty list. */
+  static List<Object> asList(Object value) {
+    if (value instanceof Collection<?> items) {
+      return new ArrayList<>(items);
+    }
+    return List.of();
+  }
+
+  /** Returns the scalar under the key as a string, or null when missing or not a scalar. */
+  static String scalar(Map<String, Object> map, String key) {
+    Object value = map.get(key);
+    if (value == null || value instanceof Collection<?> || value instanceof Map<?, ?>) {
+      return null;
+    }
+    return value.toString();
+  }
+
+  /** Returns the scalars under the key; a lone scalar becomes a singleton list. */
+  static List<String> scalars(Map<String, Object> map, String key) {
+    Object value = map.get(key);
+    if (value == null || value instanceof Map<?, ?>) {
+      return List.of();
+    }
+    if (value instanceof Collection<?> items) {
+      List<String> result = new ArrayList<>();
+      for (Object item : items) {
+        if (item != null && !(item instanceof Collection<?>) && !(item instanceof Map<?, ?>)) {
+          result.add(item.toString());
+        }
+      }
+      return List.copyOf(result);
+    }
+    return List.of(value.toString());
+  }
+
+  /** Returns the maps in the list under the key, skipping items that are not maps. */
+  static List<Map<String, Object>> maps(Map<String, Object> map, String key) {
+    List<Map<String, Object>> result = new ArrayList<>();
+    for (Object item : asList(map.get(key))) {
+      if (item instanceof Map<?, ?>) {
+        result.add(asMap(item));
+      }
+    }
+    return List.copyOf(result);
+  }
+}
