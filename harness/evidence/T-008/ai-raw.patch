+
+# API documentation (springdoc). The export committed at docs/reference/openapi.yaml is compared
+# with /v3/api-docs.yaml by OpenApiIT; keys are written in sorted order so that diff is stable.
+springdoc.api-docs.version=openapi_3_1
+springdoc.swagger-ui.path=/swagger-ui.html
+springdoc.writer-with-order-by-keys=true
+springdoc.show-actuator=false
+springdoc.default-produces-media-type=application/json
+# No petstore sample: Swagger UI loads only this service's document.
+springdoc.swagger-ui.disable-swagger-default-url=true
